   },
   "samples": ":scope > :nth-child(4) > :nth-child(2) > div",
   "pick": "f.v",
   "bind": {
    "fsrs": {
     "html": {
      ":scope > :nth-child(1) > :nth-child(2)": "e(f.h)",
      ":scope > :nth-child(1) > :nth-child(3)": "e(f.p)"
     },
     "text": {
      "ubiquitous": "'ubiquitous'",
      "FSRS-v5": "'FSRS-v5'"
     }
    },
    "call": {
     "html": {
      ":scope > :nth-child(1) > :nth-child(2)": "e(f.h)",
      ":scope > :nth-child(1) > :nth-child(3)": "e(f.p)"
     },
     "text": {
      "“Great sentence! Try ‘although’.”": "'“Great sentence! Try ‘although’.”'"
     }
    },
    "exam": {
     "html": {
      ":scope > :nth-child(1) > :nth-child(2)": "e(f.h)",
      ":scope > :nth-child(1) > :nth-child(3)": "e(f.p)"
     },
     "text": {
      "IELTS": "'IELTS'",
      "TOEIC": "'TOEIC'",
      "TOEFL": "'TOEFL'",
      "Task 2 Academic": "'Task 2 Academic'"
     }
    },
    "ext": {
     "html": {
      ":scope > :nth-child(1) > :nth-child(2)": "e(f.h)",
      ":scope > :nth-child(1) > :nth-child(3)": "e(f.p)"
     },
     "tag": {
      ":scope > :nth-child(2)": {
       "to": "a"
      }
     },
     "attr": {
      ":scope > :nth-child(2)": {
       "href": "d.store",
       "target": "'_blank'",
       "rel": "'noopener'"
      }
     },
     "addClass": {
      ":scope > :nth-child(2)": "min-h-[44px]"
     },
     "text": {
      "disparities": "'disparities'",
      "...economic": "'...economic'",
      "continue...": "'continue...'"
     }
    },
    "plain": {
     "html": {
      ":scope > :nth-child(1) > :nth-child(2)": "e(f.h)",
      ":scope > :nth-child(1) > :nth-child(3)": "e(f.p)"
     },
     "remove": [
      ":scope > :nth-child(1) > :nth-child(1)",
      ":scope > :nth-child(2)"
     ]
    }
   }
  },
  {
   "list": "d.rescards",
   "as": "r",
