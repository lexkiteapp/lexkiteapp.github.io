   "attr": {
    ":scope": {
     "href": "k[0]"
    }
   },
   "html": {
    ":scope": "e(k[1])"
   }
  },
  {
   "list": "d.feat",
   "as": "f",
   "variants": {
    "fsrs": ":scope > :nth-child(4) > :nth-child(2) > :nth-child(1)",
    "call": ":scope > :nth-child(4) > :nth-child(2) > :nth-child(2)",
