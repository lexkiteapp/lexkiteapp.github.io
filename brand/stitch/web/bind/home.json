      ":scope > :nth-child(1) > :nth-child(2)": "e(r.h)",
      ":scope > :nth-child(1) > :nth-child(3)": "e(r.p)",
      ":scope > :nth-child(2) > :nth-child(1)": "e(r.more)"
     }
    },
    "doc": {
     "attr": {
      ":scope": {
       "href": "r.href",
       "hreflang": "r.hl"
      }
     },
     "html": {
      ":scope > :nth-child(1) > :nth-child(2)": "e(r.h)",
      ":scope > :nth-child(1) > :nth-child(3)": "e(r.p)",
      ":scope > :nth-child(2) > :nth-child(1)": "e(r.more)"
     }
    },
    "list": {
     "attr": {
      ":scope": {
       "href": "r.href",
       "hreflang": "r.hl"
      }
     },
     "html": {
      ":scope > :nth-child(1) > :nth-child(2)": "e(r.h)",
      ":scope > :nth-child(1) > :nth-child(3)": "e(r.p)",
      ":scope > :nth-child(2) > :nth-child(1)": "e(r.more)"
     }
    }
   }
  },
  {
   "list": "d.faq",
   "as": "q",
   "variants": {
    "first": ":scope > :nth-child(7) > :nth-child(2) > :nth-child(1)",
    "one": ":scope > :nth-child(7) > :nth-child(2) > :nth-child(1)"
   },
   "samples": ":scope > :nth-child(7) > :nth-child(2) > div",
   "pick": "i === 0 ? 'first' : 'one'",
   "bind": {
    "first": {
     "tag": {
      ":scope > :nth-child(1)": {
       "to": "summary"
      },
      ":scope": {
       "to": "details"
      }
     },
     "html": {
      ":scope > :nth-child(1) > :nth-child(1)": "e(q[0])",
      ":scope > :nth-child(2)": "e(q[1])"
     },
     "attr": {
      ":scope": {
       "open": "''"
      }
     }
    },
    "one": {
     "tag": {
      ":scope > :nth-child(1)": {
       "to": "summary"
      },
      ":scope": {
       "to": "details"
      }
     },
     "html": {
      ":scope > :nth-child(1) > :nth-child(1)": "e(q[0])",
      ":scope > :nth-child(2)": "e(q[1])",
      ":scope > :nth-child(1) > :nth-child(2)": "'expand_more'"
     }
    }
   }
  },
  {
   "list": "d.cols",
   "as": "c",
   "sel": ":scope > :nth-child(9) > :nth-child(1) > :nth-child(2)",
   "samples": ":scope > :nth-child(9) > :nth-child(1) > :nth-child(2), :scope > :nth-child(9) > :nth-child(1) > :nth-child(3), :scope > :nth-child(9) > :nth-child(1) > :nth-child(4)",
   "html": {
    ":scope > :nth-child(1)": "e(c.h)"
   },
   "tag": {
    ":scope > :nth-child(1)": {
     "to": "h3"
    }
   },
   "repeat": [
    {
     "list": "c.items",
     "as": "it",
     "sel": ":scope > ul > li:nth-child(1)",
     "samples": ":scope > ul > li",
     "attr": {
      ":scope > a": {
       "href": "it[0]"
      }
     },
     "html": {
      ":scope > a": "e(it[1])"
     },
     "addClass": {
      ":scope > a": "min-w-[44px]"
     }
    }
   ]
  }
 ],
