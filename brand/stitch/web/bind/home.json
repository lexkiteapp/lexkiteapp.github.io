    ":scope": {
     "href": "n[0]",
     "hreflang": "n[2]"
    }
   },
   "text": {
    "Blog": "n[1]"
   }
  },
  {
   "list": "d.heroLinks",
   "as": "k",
   "sel": ":scope > :nth-child(2) > :nth-child(1) > :nth-child(5) > :nth-child(1)",
