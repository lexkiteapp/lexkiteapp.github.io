  ":scope > :nth-child(9) > :nth-child(1) > :nth-child(1) > :nth-child(3)": "d.getApp",
  ":scope > :nth-child(9) > :nth-child(2) > :nth-child(1) > :nth-child(2)": "d.menu2",
