      ":scope": "inline-flex items-center justify-center min-h-[44px] min-w-[44px]"
     }
    },
    "sep": {},
    "cur": {
     "attr": {
      ":scope": {
       "aria-current": "'page'"
      }
     },
     "html": {
      ":scope": "e(c.name)"
     }
    }
   }
  },
