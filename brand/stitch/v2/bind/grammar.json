{
 "_doc": "Màn Ngữ pháp (#/grammar, hub + danh sách bài) – d do web/js/grammar.js (hubData) dựng từ dữ liệu thật. Đầu trang + thanh tab chung (tab Kỹ năng) do shell.js; đầu trang riêng của mẫu (Back + tiêu đề + số bài) giữ trong nội dung, không dính. Chỗ mới của mục cũ không có trong mẫu: vòng tiến độ → thanh tiến độ; mô tả hub → đoạn chữ cuối thẻ tiến độ; tên Anh/mô tả bài kế → dòng phụ; chương gập mở (details) có mô tả + tiến độ; đề tổng hợp 40 câu + Chia động từ + Sửa ngữ pháp → cùng khuôn thẻ 'Mixed test' (d.cards, thẻ là liên kết).",
 "swap": {
  "w-[390px]": "w-full",
  "max-w-[390px]": "max-w-3xl",
  "min-h-screen": "min-h-0",
  "sticky": "",
  "top-0": "",
  "z-30": "",
  "pb-10": "pt-14 pb-20"
 },
 "attr": {
  ":scope > main > header > button": {
   "aria-label": "t('Quay lại')",
   "data-gh": "'back'"
  },
  ":scope > main > div > div:nth-child(1) > div:nth-child(1)": {
   "role": "'progressbar'",
   "aria-valuemin": "0",
   "aria-valuemax": "100",
   "aria-valuenow": "d.pct",
   "aria-label": "d.prog"
  },
  ":scope > main > div > div:nth-child(1) > div:nth-child(1) > div": {
   "style": "'width:' + d.pct + '%'"
  },
  ":scope > main > div > div:nth-child(1) > h2": {
   "style": "d.nx ? '' : 'display:none'"
  },
  ":scope > main > div > div:nth-child(1) > button": {
   "data-href": "d.nx ? d.nx.href : ''",
   "style": "d.nx ? '' : 'display:none'"
  },
  ":scope > main > div > div:nth-child(2)": {
   "role": "'group'",
   "aria-label": "d.title",
   "id": "'gTabs'"
  }
 },
 "addClass": {
  ":scope > main > header > button > span": "rtl:-scale-x-100",
  ":scope > main > header > div": "min-w-0",
  ":scope > main > header > div > p": "[overflow-wrap:anywhere]",
  ":scope > main > div": "w-full",
  ":scope > main > div > div:nth-child(2)": "pb-1",
  ":scope > main > div > div:nth-child(1) > button": "min-h-[48px]"
 },
 "text": {
  "Grammar": "d.title",
  "80 visual lessons": "d.sub",
  "32/80 lessons passed": "d.prog",
  "Next: Present perfect": "d.nx ? d.nx.h : ''",
  "Start now": "d.cta"
 },
 "after": {
  ":scope > main > div > div:nth-child(1) > h2": "d.nx && d.nx.sub ? '<p class=\"text-[13px] font-semibold leading-snug lt:text-[#496064] dk:text-[#BFD3D0]\">' + e(d.nx.sub) + '</p>' : ''",
  ":scope > main > div > div:nth-child(1) > button": "'<p class=\"text-[12px] font-semibold leading-snug lt:text-[#496064] dk:text-[#BFD3D0]\">' + e(d.blurb) + '</p>'"
 },
 "repeat": [
  {
   "list": "d.chips",
   "as": "r",
   "variants": {
    "on": ":scope > main > div > div:nth-child(2) > span:nth-child(1)",
    "idle": ":scope > main > div > div:nth-child(2) > span:nth-child(2)"
   },
   "samples": ":scope > main > div > div:nth-child(2) > span",
   "pick": "r.on ? 'on' : 'idle'",
   "bind": {
    "on": {
     "tag": {
      ":scope": {
       "to": "button",
       "addClass": "shrink-0 whitespace-nowrap"
      }
     },
     "attr": {
      ":scope": {
       "type": "'button'",
       "aria-pressed": "'true'",
       "data-gt": "r.k"
      }
     },
     "text": {
      "All 80": "r.l"
     }
    },
    "idle": {
     "tag": {
      ":scope": {
       "to": "button",
       "addClass": "shrink-0 whitespace-nowrap"
      }
     },
     "attr": {
      ":scope": {
       "type": "'button'",
       "aria-pressed": "'false'",
       "data-gt": "r.k"
      }
     },
     "text": {
      "IELTS 7.0+": "r.l"
     }
    }
   }
  },
  {
   "list": "d.cards",
   "as": "r",
   "variants": {
    "one": ":scope > main > div > div:nth-child(4)"
   },
   "samples": ":scope > main > div > div:nth-child(4)",
   "bind": {
    "one": {
     "tag": {
      ":scope": {
       "to": "a",
       "addClass": "block min-h-[44px] lt:active:[background-color:#FFF8F3] dk:active:[background-color:#1D2F33]"
      }
     },
     "attr": {
      ":scope": {
       "href": "r.href"
      }
     },
     "text": {
      "Mixed test · 20 questions": "r.t",
      "Questions from the lessons you studied.": "r.s"
     }
    }
   }
  },
  {
   "list": "d.ch",
   "as": "c",
   "variants": {
    "ch": ":scope > main > div > div:nth-child(3)",
    "empty": ":scope > main > div > div:nth-child(3)"
   },
   "samples": ":scope > main > div > div:nth-child(3)",
   "pick": "c.empty ? 'empty' : 'ch'",
   "bind": {
    "empty": {
     "remove": [
      ":scope > div"
     ],
     "text": {
      "Chapter 1 · Tenses": "c.h"
     }
    },
    "ch": {
     "repeat": [
      {
       "list": "c.rows",
       "as": "r",
       "variants": {
        "done": ":scope > div:nth-child(2)",
        "weak": ":scope > div:nth-child(3)",
        "plain": ":scope > div:nth-child(4)",
        "test": ":scope > div:nth-child(5)"
       },
       "samples": ":scope > div",
       "pick": "r.test ? 'test' : r.pct == null ? 'plain' : r.pct >= 80 ? 'done' : 'weak'",
       "bind": {
        "done": {
         "tag": {
          ":scope": {
           "to": "a"
          }
         },
         "attr": {
          ":scope": {
           "href": "r.href",
           "data-grow": "r.id"
          }
         },
         "html": {
          ":scope > span:nth-child(1)": "e(r.t) + (r.s ? '<small class=\"block text-[12px] font-semibold lt:text-[#496064] dk:text-[#BFD3D0]\">' + e(r.s) + '</small>' : '')",
          ":scope > span:nth-child(2)": "e(r.lv)",
          ":scope > span:nth-child(3)": "'✓ ' + e(r.pct) + '%'"
         },
         "addClass": {
          ":scope": "min-h-[48px] py-1",
          ":scope > span:nth-child(1)": "min-w-0 flex-1 [overflow-wrap:anywhere]",
          ":scope > span:nth-child(2)": "shrink-0",
          ":scope > span:nth-child(3)": "shrink-0"
         }
        },
        "weak": {
         "tag": {
          ":scope": {
           "to": "a"
          }
         },
         "attr": {
          ":scope": {
           "href": "r.href",
           "data-grow": "r.id"
          }
         },
         "html": {
          ":scope > span:nth-child(1)": "e(r.t) + (r.s ? '<small class=\"block text-[12px] font-semibold lt:text-[#496064] dk:text-[#BFD3D0]\">' + e(r.s) + '</small>' : '')",
          ":scope > span:nth-child(2)": "e(r.lv)",
          ":scope > span:nth-child(3)": "e(r.pct) + '%'"
         },
         "addClass": {
          ":scope": "min-h-[48px] py-1",
          ":scope > span:nth-child(1)": "min-w-0 flex-1 [overflow-wrap:anywhere]",
          ":scope > span:nth-child(2)": "shrink-0",
          ":scope > span:nth-child(3)": "shrink-0"
         }
        },
        "plain": {
         "tag": {
          ":scope": {
           "to": "a"
          }
         },
         "attr": {
          ":scope": {
           "href": "r.href",
           "data-grow": "r.id"
          }
         },
         "html": {
          ":scope > span:nth-child(1)": "e(r.t) + (r.s ? '<small class=\"block text-[12px] font-semibold lt:text-[#496064] dk:text-[#BFD3D0]\">' + e(r.s) + '</small>' : '')",
          ":scope > span:nth-child(2)": "e(r.lv)"
         },
         "addClass": {
          ":scope": "min-h-[48px] py-1",
          ":scope > span:nth-child(1)": "min-w-0 flex-1 [overflow-wrap:anywhere]",
          ":scope > span:nth-child(2)": "shrink-0"
         }
        },
        "test": {
         "tag": {
          ":scope": {
           "to": "a"
          }
         },
         "attr": {
          ":scope": {
           "href": "r.href"
          }
         },
         "html": {
          ":scope > span:nth-child(1)": "e(r.t) + '<small class=\"block text-[12px] font-semibold lt:text-[#496064] dk:text-[#BFD3D0]\">' + e(r.s) + '</small>'",
          ":scope > span:nth-child(2)": "'›'"
         },
         "addClass": {
          ":scope": "min-h-[48px] py-1 border-b-0",
          ":scope > span:nth-child(1)": "min-w-0 flex-1 [overflow-wrap:anywhere] lt:!text-[#0F3D3E] dk:!text-[#5EEAD4]",
          ":scope > span:nth-child(2)": "shrink-0 text-[18px] rtl:-scale-x-100"
         }
        }
       }
      }
     ],
     "html": {
      ":scope > h2": "'<span class=\"block min-w-0 flex-1\"><h2 class=\"text-[16px] font-extrabold leading-tight [overflow-wrap:anywhere]\">' + e(c.h) + '</h2>' + (c.desc ? '<span class=\"mt-0.5 block text-[12px] font-semibold leading-snug lt:text-[#496064] dk:text-[#BFD3D0]\">' + e(c.desc) + '</span>' : '') + '</span><span class=\"flex shrink-0 flex-col items-end gap-1\"><span class=\"text-[12px] font-extrabold lt:text-[#496064] dk:text-[#BFD3D0]\">' + e(c.dn) + '/' + e(c.total) + '</span><span class=\"block h-1.5 w-14 overflow-hidden rounded-full lt:bg-[#ECE4D7] dk:bg-[#37525A]\"><i class=\"block h-full rounded-full lt:bg-[#0F3D3E] dk:bg-[#5EEAD4]\" style=\"width:' + e(c.pct) + '%\"></i></span></span><svg class=\"h-5 w-5 shrink-0 transition-transform group-open:rotate-90 rtl:-scale-x-100\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 6 6 6-6 6\"/></svg>'"
     },
     "attr": {
      ":scope": {
       "data-open": "c.open ? '1' : '0'",
       "id": "c.id"
      }
     },
     "tag": {
      ":scope > h2": {
       "to": "summary",
       "addClass": "flex min-h-[44px] cursor-pointer list-none items-center justify-between gap-3"
      },
      ":scope": {
       "to": "details",
       "addClass": "group"
      }
     }
    }
   }
  }
 ]
}
