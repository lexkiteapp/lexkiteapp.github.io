   "type": "'button'"
  },
  ":scope > main > div > div:nth-child(5) > div:nth-child(4) > button": {
   "id": "'lsnNext'",
   "type": "'button'"
  },
  ":scope > main > div > div:nth-child(5) .material-symbols-outlined": {
   "aria-hidden": "'true'"
  },
  ":scope > main > div > div:nth-child(5) > div:nth-child(2) > div:nth-child(2) > div > button:nth-child(1)": {
   "type": "'button'",
   "data-speak": "d.say",
   "data-accent": "d.acc1",
   "data-url": "d.url1",
   "aria-label": "d.ar1"
  },
  ":scope > main > div > div:nth-child(5) > div:nth-child(2) > div:nth-child(2) > div > button:nth-child(2)": {
   "type": "'button'",
   "data-speak": "d.say",
   "data-accent": "d.acc2",
