   "tabindex": "'-1'",
   "aria-hidden": "'true'"
  },
  ":scope > main > div > div:nth-child(1) > div:nth-child(1) > button": {
   "id": "'qClear'",
   "type": "'button'",
   "aria-label": "d.clearL"
  }
 },
