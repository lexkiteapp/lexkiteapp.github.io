       "gap-1.5": "''"
      }
     },
     "addClass": {
      ":scope > div:nth-child(2)": "gap-3"
     }
    }
   }
  },
  {
   "list": "d.browseBlk",
   "as": "b",
   "samples": ":scope > main > div > section:nth-child(2) > div",
