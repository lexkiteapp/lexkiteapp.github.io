  ":scope > main > header": "gap-2 px-0",
  ":scope > main > div > div:nth-child(1) > div:nth-child(1) > span": "min-w-[44px] min-h-[44px] justify-center left-0 cursor-pointer",
  ":scope > main > div > div:nth-child(1) > div:nth-child(1) > input": "[font-size:16px] [text-overflow:ellipsis]",
  ":scope > main > header > button:nth-child(1) > span": "ms-flip"
 },
 "repeat": [
