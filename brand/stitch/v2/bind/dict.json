           "lang": "'en'",
           "type": "null"
          }
         },
         "addClass": {
          ":scope": "relative inline-flex items-center no-underline after:absolute after:-inset-1.5 after:content-['']"
         },
         "tag": {
          ":scope": {
           "to": "a"
          }
         }
        }
       }
      }
     ],
     "cls": {
      ":scope > div:nth-child(2)": {
       "gap-1.5": "''"
      }
     },
     "addClass": {
      ":scope > div:nth-child(2)": "gap-3"
     }
    }
   }
  }
 ],
