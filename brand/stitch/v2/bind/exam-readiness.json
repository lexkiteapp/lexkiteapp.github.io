    "weak": ":scope > main > div > div:nth-child(3) > div:nth-child(3)"
   },
   "bind": {
    "ok": {
     "tag": {
      ":scope": {
       "to": "a"
      }
     },
     "attr": {
      ":scope": {
       "href": "r.href",
       "aria-label": "r.al",
       "role": "'listitem'"
      },
      ":scope > div:nth-child(2) > div:nth-child(3) > div": {
       "style": "'width:' + r.w + '%'"
      }
     },
     "html": {
      ":scope > div:nth-child(1) > div > span": "e(r.icon)",
      ":scope > div:nth-child(1) > span": "e(r.status)",
      ":scope > div:nth-child(2) > span": "e(r.name)",
      ":scope > div:nth-child(2) > div:nth-child(2) > span:nth-child(1)": "e(r.band)",
      ":scope > div:nth-child(2) > div:nth-child(2) > span:nth-child(2)": "e('/ ' + r.top)"
     }
    },
    "weak": {
     "tag": {
      ":scope": {
       "to": "a"
      }
     },
     "attr": {
      ":scope": {
       "href": "r.href",
       "aria-label": "r.al",
       "role": "'listitem'"
      },
      ":scope > div:nth-child(2) > div:nth-child(3) > div": {
       "style": "'width:' + r.w + '%'"
      }
     },
     "html": {
      ":scope > div:nth-child(1) > div > span": "e(r.icon)",
      ":scope > div:nth-child(1) > span": "e(r.status)",
      ":scope > div:nth-child(2) > div:nth-child(1) > span:nth-child(1)": "e(r.name)",
      ":scope > div:nth-child(2) > div:nth-child(1) > span:nth-child(2)": "e(r.gap)",
      ":scope > div:nth-child(2) > div:nth-child(2) > span:nth-child(1)": "e(r.band)",
      ":scope > div:nth-child(2) > div:nth-child(2) > span:nth-child(2)": "e('/ ' + r.top)"
     }
    }
   }
  }
 ],
