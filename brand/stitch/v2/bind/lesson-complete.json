   "truncate": "''"
  },
  ":scope > main > div > div:nth-child(5) > div:nth-child(2) > span:nth-child(2)": {
   "truncate": "''"
  }
 },
 "tag": {
  ":scope > header > div > button": {
   "to": "a"
  },
  ":scope > header > div > div:nth-child(3)": {
   "to": "button"
  },
  ":scope > main > div > div:nth-child(1) > button:nth-child(1)": {
   "to": "a"
  },
  ":scope > main > div > div:nth-child(6) > button:nth-child(2)": {
   "to": "a"
  }
 },
