{
 "_doc": "Màn Hoàn thành bài học (#/lesson/go, cờ ux1) – d do web/js/lesson/ui.js finish() dựng từ phiên thật. Ama (cheer, ảnh tĩnh) đứng SAU thẻ 'sub' đục (thẻ kéo lên chồng đáy hình). Combo/thời gian/từ đã học/từ sai/không sai câu nào nằm trong thẻ này (d.more); Bài khác = #lsnAgain; nút thứ hai = Sổ lỗi sai (có câu sai) hoặc Bản đồ bài học; X (2 chỗ) = Bản đồ bài học; Chia sẻ = #lsnShare.",
 "i18n": {
  "Close lesson": "Thoát bài học",
  "Learner profile": "Hồ sơ người học",
  "Lesson complete!": "Hoàn thành bài học!",
  "Share results": "Chia sẻ kết quả",
  "TOTAL XP": "Tổng XP",
  "ACCURACY": "Chính xác",
  "STREAK": "Chuỗi"
 },
 "text": {
  "Active Drill Session": "d.title",
  "70%": "d.pct",
  "UNIT 3 • WRITING TASK 1": "d.chip",
  "+25": "d.xp",
  "100%": "d.acc",
  "14": "d.streak",
  "Vocabulary Mastery +3": "d.sub",
  "Mastered 4 complex linking expressions today.": "d.learned",
  "CONTINUE": "t('Bài khác')",
  "REVIEW LESSON": "d.rev"
 },
