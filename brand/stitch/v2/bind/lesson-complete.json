  ":scope > div > main > div > div:nth-child(5) > button:nth-child(2)": "'<span class=\"material-symbols-outlined text-[18px] opacity-75\" aria-hidden=\"true\">' + e(d.revIcon) + '</span> ' + e(d.rev)"
 },
 "setClass": {
  ":scope > div > main > div > div:nth-child(3) > div:nth-child(1)": "relative w-16 h-20 shrink-0 self-end"
 },
 "remove": [
