  ":scope > main > div > div:nth-child(1) > button:nth-child(1)": {
   "href": "d.close",
   "id": "'lsnX2'",
   "aria-label": "d.mapL"
  },
  ":scope > main > div > div:nth-child(1) > button:nth-child(3)": {
   "id": "'lsnShare'",
   "type": "'button'"
  },
  ":scope > main > div > div:nth-child(3) > div > svg:nth-child(2) > circle:nth-child(2)": {
   "stroke-dashoffset": "d.off1"
  },
  ":scope > main > div > div:nth-child(3) > div > svg:nth-child(3) > circle:nth-child(2)": {
   "stroke-dashoffset": "d.off2"
  },
  ":scope > main > div > div:nth-child(6) > button:nth-child(1)": {
   "id": "'lsnAgain'",
   "type": "'button'"
  },
  ":scope > main > div > div:nth-child(6) > button:nth-child(2)": {
   "id": "'lsnRev'",
   "href": "d.revHref"
  },
  ":scope .material-symbols-outlined": {
   "aria-hidden": "'true'"
  }
 },
 "cls": {
