   "aria-label": "t('Thoát bài học')"
  },
  ":scope > div > main > div > div:nth-child(1) > div:nth-child(2) > div:nth-child(2) > svg > circle:nth-child(2)": {
   "stroke-dashoffset": "d.off1"
  },
  ":scope > div > main > div > div:nth-child(1) > div:nth-child(2) > div:nth-child(2) > svg > circle:nth-child(4)": {
   "stroke-dashoffset": "d.off2"
  },
  ":scope > div > main > div > div:nth-child(5) > button:nth-child(1)": {
   "id": "'lsnAgain'"
  },
  ":scope > div > main > div > div:nth-child(5) > button:nth-child(2)": {
   "id": "'lsnRev'",
   "href": "d.revHref"
  },
  ":scope svg": {
   "aria-hidden": "'true'"
  }
 },
 "tag": {
  ":scope > div > main > div > div:nth-child(1) > div:nth-child(1) > button": {
   "to": "a"
  },
  ":scope > div > main > div > div:nth-child(5) > button:nth-child(2)": {
   "to": "a"
  }
 },
 "addClass": {
  ":scope > div > main > div > div:nth-child(1) > div:nth-child(1) > button": "no-underline",
  ":scope > div > main > div > div:nth-child(1) > div:nth-child(1) > div": "min-w-0 max-w-[70%] break-words",
  ":scope > div > main > div > div:nth-child(1) > div:nth-child(2) > div:nth-child(2)": "lsn-ring",
  ":scope > div > main > div > div:nth-child(1) > div:nth-child(3)": "lsn-xp",
  ":scope > div > main > div > div:nth-child(2)": "lsn-tiles",
  ":scope > div > main > div > div:nth-child(3)": "lsn-sub",
  ":scope > div > main > div > div:nth-child(4)": "lsn-week",
  ":scope > div > main > div > div:nth-child(5)": "lsn-cta sticky bottom-0 z-10 lt:bg-[#FBF7F1] dk:bg-[#091416]",
  ":scope > div > main > div > div:nth-child(5) > button:nth-child(2)": "no-underline",
  ":scope > div > main > div > div:nth-child(3) > div:nth-child(2)": "lsn-learned"
 },
 "html": {
  ":scope > div > main > div > div:nth-child(3) > div:nth-child(1)": "'<div id=\"lsnTch\" class=\"relative w-full h-full\"></div>'",
