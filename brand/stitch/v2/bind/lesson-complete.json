 ],
 "after": {
  ":scope > div > main > div > div:nth-child(5) > button:nth-child(2)": "'<button type=\"button\" id=\"lsnShare\" class=\"absolute bottom-0 right-1 w-11 h-11 flex items-center justify-center rounded-xl lt:text-[#145652] dk:text-[#6BD8CE] active:scale-95\" aria-label=\"' + e(t('Chia sẻ kết quả')) + '\"><span class=\"material-symbols-outlined text-[20px]\" aria-hidden=\"true\">ios_share</span></button>'",
  ":scope > div > main > div > div:nth-child(3) > div:nth-child(2) > div:nth-child(2)": "(d.wl.length ? '<a class=\"lsn-rev no-underline mt-1 min-h-[44px] inline-flex items-center px-1 text-[12px] font-bold lt:text-[#145652] dk:text-[#6BD8CE]\" href=\"#/review\">' + e(t('Ôn lại')) + '</a>' : '') + d.more"
 },
 "keys": {
  "Chia sẻ kết quả": "Share results",
  "Chính xác": "Accuracy"
 },
 "repeat": [
  {
   "sel": ":scope > div > main > div > div:nth-child(3) > div:nth-child(2) > div:nth-child(2) > span:nth-child(1)",
   "samples": ":scope > div > main > div > div:nth-child(3) > div:nth-child(2) > div:nth-child(2) > span",
   "list": "d.wl",
   "as": "p",
   "bind": {
    "one": {
     "tag": {
      ":scope": {
       "to": "button"
      }
     },
     "attr": {
      ":scope": {
       "type": "'button'",
       "data-say": "p.card.word",
       "lang": "'en'",
       "aria-label": "t('Chạm để nghe') + ': ' + p.card.word"
      }
     },
     "text": {
      "afraid": "p.card.word"
     },
     "addClass": {
      ":scope": "min-h-[44px] inline-flex items-center"
     }
    }
   }
  }
 ]
