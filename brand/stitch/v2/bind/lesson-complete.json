  "Everyday English · Lesson 3/12": "d.chip",
  "+25 XP": "d.xpL",
  "12": "d.combo",
  "4/4": "d.first",
  "1:45": "d.mins",
  "4": "d.nwords",
  "Best Combo": "t('Combo tốt nhất')",
  "First Try": "t('Nhớ ngay')",
  "Time": "t('Thời gian')",
  "Words": "t('Từ mới')",
  "Awesome!": "d.sub",
  "New vocabulary locked in:": "d.learned",
  "Current streak: 14 days": "d.streakT",
  "This week: 5 days": "d.weekN",
  "Next lesson": "t('Bài tiếp theo')",
  "Lesson map": "d.rev"
 },
 "attr": {
