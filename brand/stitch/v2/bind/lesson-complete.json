  ":scope > main > div > div:nth-child(1) > button:nth-child(3)": "relative after:absolute after:-inset-1 after:content-['']",
  ":scope > main > div > div:nth-child(1) > div:nth-child(2)": "max-w-[60%]",
  ":scope > main > div > div:nth-child(4)": "lsn-stats",
  ":scope > main > div > div:nth-child(5)": "relative z-10 lsn-sub",
  ":scope > main > div > div:nth-child(5) > div:nth-child(2) > span": "break-words",
  ":scope > main > div > div:nth-child(6) > button:nth-child(2)": "no-underline"
 },
