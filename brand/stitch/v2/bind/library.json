   "pick": "r.on ? 'on' : r.g === 'mine' ? 'mine' : 'off'",
   "variants": {
    "on": ":scope > header > div > div:nth-child(3) > button:nth-child(1)",
    "off": ":scope > header > div > div:nth-child(3) > button:nth-child(2)",
    "mine": ":scope > header > div > div:nth-child(3) > button:nth-child(6)"
   },
   "bind": {
    "on": {
     "addClass": {
      ":scope": "on"
     },
     "attr": {
      ":scope": {
       "data-g": "r.g",
       "aria-pressed": "'true'",
       "type": "'button'"
      },
      ":scope > span": {
       "style": "r.icon ? '' : 'display:none'"
      }
     },
     "html": {
      ":scope > span": "e(r.icon)"
