{
 "_doc": "Thư viện (#/library, cờ ux1) – d do web/js/app.js libV2() dựng từ TOPICS/GROUPS/state.cards thật. Đầu trang Stitch giữ (quay lại #/train, chuỗi/XP thật, ô lọc #libQ, Anki xuất/nhập #libAnkiOut/#libAnkiIn); tab nhóm #libTabs (data-g, .on) + CEFR [data-lvf]; mỗi lần đổi tab/lọc dựng lại khung (giữ con trỏ ô lọc). Thẻ nổi bật = bộ đang học dở nhiều nhất (hoặc bộ đầu của nhóm theo kỳ thi) – dữ liệu thật, A/B chủ. 'Tạo bộ của bạn' → Nhập từ Anki (tính năng thật). Thanh tab dưới = shell (tab Luyện).",
 "remove": [
  ":scope > nav"
 ],
 "i18n": {
  "Vocabulary library": "Thư viện từ vựng",
  "Go back": "Trở về trang trước",
  "export": "Xuất",
  "CEFR:": "CEFR:",
  "Study": "Học bộ này",
  "Create your own set": "Tạo bộ từ của bạn",
  "Export Anki deck (.apkg)": "Xuất bộ thẻ Anki (.apkg)",
  "Import Anki deck": "Nhập bộ thẻ Anki"
 },
 "attr": {
  ":scope > header > div > div:nth-child(1) > div:nth-child(1) > button": {
   "data-href": "'#/train'"
  },
  ":scope > header > div > div:nth-child(2) > div > input": {
   "id": "'libQ'",
   "placeholder": "d.qPh",
   "value": "d.q",
   "aria-label": "d.qPh"
  },
  ":scope > header > div > div:nth-child(2) > button:nth-child(2)": {
   "id": "'libAnkiOut'",
   "aria-label": "d.ankiOut"
  },
  ":scope > header > div > div:nth-child(2) > button:nth-child(3)": {
   "id": "'libAnkiIn'",
   "aria-label": "d.ankiIn"
  },
  ":scope > header > div > div:nth-child(3)": {
   "id": "'libTabs'",
   "role": "'group'",
   "aria-label": "d.groupsL"
  },
  ":scope > header > div > div:nth-child(4)": {
   "role": "'group'",
   "aria-label": "d.lvL"
  },
  ":scope > main > div:nth-child(1)": {
   "style": "d.feat ? '' : 'display:none'"
  },
  ":scope > main > div:nth-child(1) > button": {
   "data-href": "d.feat ? d.feat.href : ''"
  },
  ":scope > main > div:last-child > button": {
   "id": "'libNewSet'",
   "type": "'button'"
  }
 },
 "html": {
  ":scope > header > div > div:nth-child(1) > div:nth-child(1) > div > p > span:nth-child(1)": "e(d.words)",
  ":scope > header > div > div:nth-child(1) > div:nth-child(1) > div > p > span:nth-child(3)": "e(d.sets)",
  ":scope > header > div > div:nth-child(1) > div:nth-child(2) > div:nth-child(1) > span:nth-child(2)": "e(d.hdr.streak)",
  ":scope > header > div > div:nth-child(1) > div:nth-child(2) > div:nth-child(2) > span:nth-child(2)": "e(d.hdr.xp)",
  ":scope > main > div:nth-child(1) > div > div > span:nth-child(1)": "e(d.featL)",
  ":scope > main > div:nth-child(1) > div > div > span:nth-child(2)": "e(d.feat ? d.feat.group : '')",
  ":scope > main > div:nth-child(1) > div > h2": "e(d.feat ? d.feat.name : '')",
  ":scope > main > div:nth-child(1) > div > p": "e(d.feat ? d.feat.desc : '')",
  ":scope > main > div:last-child > div > div:nth-child(2) > p": "e(d.newSetSub)",
  ":scope > main > div:last-child > button": "e(t('Nhập từ Anki'))"
 },
 "after": {
  ":scope > main > div:first-child": "d.empty"
 },
 "repeat": [
  {
   "list": "d.tabsG",
   "as": "r",
