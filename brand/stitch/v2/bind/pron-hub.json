           "right-1": "'right-0'"
          }
         }
        }
       }
      }
     ]
    },
    "rows": {
     "html": {
      ":scope > div:nth-child(1) > h2": "e(g.name)",
      ":scope > div:nth-child(1) > span": "e(g.count)"
