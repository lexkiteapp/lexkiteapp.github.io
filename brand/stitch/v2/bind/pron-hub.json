  ":scope > main > div:nth-child(2) > section:nth-child(1) > div > div:nth-child(2) > div:nth-child(2) > p": "e(d.nextS)",
  ":scope > main > div:nth-child(3) button > span:nth-child(1)": "e(d.cta)"
 },
