       "aria-label": "g.name"
      }
     },
     "repeat": [
      {
       "list": "g.items",
       "as": "x",
       "samples": ":scope > div:nth-child(2) > button",
       "pick": "x.done ? 'done' : x.next ? 'focus' : 'plain'",
       "variants": {
        "done": ":scope > div:nth-child(2) > button:nth-child(1)",
        "plain": ":scope > div:nth-child(2) > button:nth-child(4)",
        "focus": ":scope > div:nth-child(2) > button:nth-child(12)"
       },
       "bind": {
        "done": {
         "html": {
          ":scope > span:nth-child(2)": "e(x.ipa)",
          ":scope > span:nth-child(3)": "e(x.w)"
         },
         "attr": {
          ":scope": {
           "href": "x.href",
           "aria-label": "x.label",
           "type": "null"
          },
          ":scope > span:nth-child(1)": {
           "aria-hidden": "'true'"
          }
         },
         "addClass": {
          ":scope": "no-underline",
          ":scope > span:nth-child(3)": "max-w-full truncate"
         },
         "tag": {
          ":scope": {
           "to": "a"
          }
         }
        },
        "plain": {
         "html": {
          ":scope > span:nth-child(1)": "e(x.ipa)",
          ":scope > span:nth-child(2)": "e(x.w)"
         },
         "attr": {
          ":scope": {
           "href": "x.href",
           "aria-label": "x.label",
           "type": "null"
          }
         },
         "addClass": {
          ":scope": "no-underline",
          ":scope > span:nth-child(2)": "max-w-full truncate"
         },
         "tag": {
          ":scope": {
           "to": "a"
          }
         }
        },
        "focus": {
         "html": {
          ":scope > span:nth-child(2)": "e(x.ipa)",
          ":scope > span:nth-child(3)": "e(x.w)"
         },
         "attr": {
          ":scope": {
           "href": "x.href",
           "aria-label": "x.label",
           "type": "null"
          },
          ":scope > span:nth-child(1)": {
           "aria-hidden": "'true'"
          }
         },
         "addClass": {
          ":scope": "no-underline",
          ":scope > span:nth-child(3)": "max-w-full truncate"
         },
         "tag": {
          ":scope": {
           "to": "a"
          }
         }
        }
       }
      }
     ]
    },
    "c5": {
     "html": {
      ":scope > div:nth-child(1) > div > h2": "e(g.name)",
      ":scope > div:nth-child(1) > div > span": "e(g.count)",
      ":scope > div:nth-child(1) > p": "e(g.desc)",
      ":scope > div:nth-child(3) > p": "e(g.note)"
     },
     "attr": {
      ":scope": {
       "aria-label": "g.name"
      }
     },
     "repeat": [
      {
       "list": "g.items",
       "as": "x",
       "samples": ":scope > div:nth-child(2) > button",
       "pick": "x.done ? 'done' : x.next ? 'focus' : 'plain'",
       "variants": {
