          ":scope > span:nth-child(1)": "e(x.ipa)",
          ":scope > span:nth-child(2)": "e(x.w)"
         },
         "attr": {
          ":scope": {
           "href": "x.href",
           "aria-label": "x.label",
           "type": "null"
          }
         },
         "cls": {
          ":scope": {
           "border-dashed": "x.unv ? 'border-dashed' : 'border-solid'"
          }
         },
         "addClass": {
          ":scope": "no-underline"
         },
         "tag": {
          ":scope": {
           "to": "a"
          }
         }
        },
        "focus": {
         "html": {
          ":scope > span:nth-child(2)": "e(x.ipa)",
          ":scope > span:nth-child(3)": "e(x.w)"
         },
         "attr": {
          ":scope": {
           "href": "x.href",
           "aria-label": "x.label",
           "type": "null"
          },
          ":scope > span:nth-child(1)": {
           "aria-hidden": "'true'"
          }
         },
         "addClass": {
          ":scope": "no-underline"
         },
         "tag": {
          ":scope": {
           "to": "a"
