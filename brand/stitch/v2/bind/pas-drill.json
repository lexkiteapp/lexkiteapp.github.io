      }
     },
     "addClass": {
      ":scope": "relative after:absolute after:-inset-1.5 after:content-['']"
     },
     "cls": {
      ":scope": {
       "lt:text-[#15803D]": "r.p ? 'lt:text-[#1A1816]' : 'lt:text-[#15803D]'",
       "lt:bg-[#ECFDF5]": "r.p ? 'lt:bg-[#F7EEE3]' : 'lt:bg-[#ECFDF5]'",
       "dk:text-[#34d399]": "r.p ? 'dk:text-[#ffffff]' : 'dk:text-[#34d399]'",
       "dk:bg-[#102a28]": "r.p ? 'dk:bg-[#102227]' : 'dk:bg-[#102a28]'",
       "dk:border-[#184c47]": "r.p ? 'dk:border-[#1e3e46]' : 'dk:border-[#184c47]'"
      }
     }
    },
    "bad": {
