{
 "_doc": "Màn Truyện (#/lesson/go, node.kind=story|radio, cờ ux1): khung hội thoại Ama + Carlos. d do web/js/lesson/ui.js storyFrame() dựng. Cả 2 giáo viên (Chars) đứng SAU khung đối thoại đục (d.duo chèn sau thanh người nói; khung chat z-10 nền đục); câu thoại mới nối vào danh sách (khuôn lấy từ 2 bong bóng mẫu); nút 'CHECK ANSWER' = Tiếp tục (#lsnGo); Bài kiểm giữa truyện (type 'q') = CÙNG khung Stitch: 2 bong bóng + câu hỏi (#lsnBub) + thẻ A/B/C (#lsnBody, khuôn tắt/bật lấy từ mẫu) + nút CHECK ANSWER (#lsnCheck); bước thoại ẩn khối câu hỏi, nút = Tiếp tục (#lsnGo); radio: chữ ẩn, chip giữa = ON AIR.",
 "i18n": {
  "Close session": "Thoát bài học",
  "User Profile": "Hồ sơ người học",
  "Answer options": "Các đáp án"
 },
 "text": {
  "Active Drill Session": "d.title",
  "70%": "d.pct",
  "Ama": "'Ama'",
  "Carlos": "'Carlos'",
  "CHECK ANSWER": "t('Tiếp tục')",
  "Dialogue": "d.mid",
  "What did the new timetable do to Carlos?": "d.qt"
 },
 "attr": {
  ":scope > header > div > button": {
   "href": "d.close",
   "id": "'lsnX'",
   "aria-label": "t('Thoát bài học')"
  },
  ":scope > header > div > div:nth-child(2) > div:nth-child(1) > span:nth-child(2)": {
   "dir": "'ltr'",
   "id": "'lsnPct'"
  },
  ":scope > header > div > div:nth-child(2) > div:nth-child(2)": {
   "role": "'progressbar'",
   "aria-label": "t('Tiến độ bài học')",
   "aria-valuemin": "'0'",
   "aria-valuemax": "'100'",
   "aria-valuenow": "'0'"
  },
  ":scope > header > div > div:nth-child(2) > div:nth-child(2) > div": {
   "style": "'width:0%'",
   "id": "'lsnFill'"
  },
  ":scope > header > div > div:nth-child(3)": {
   "data-href": "'#/me'",
   "type": "'button'"
  },
  ":scope > main > div > div:nth-child(2)": {
   "id": "'lsnChat'",
   "aria-live": "'polite'"
  },
  ":scope > main > div > div:nth-child(5) > button": {
   "id": "'lsnGo'",
   "type": "'button'"
  },
  ":scope .material-symbols-outlined": {
   "aria-hidden": "'true'"
  },
  ":scope > main > div > div:nth-child(3) > h2": {
   "id": "'lsnBub'"
  },
  ":scope > main > div > div:nth-child(4)": {
   "id": "'lsnBody'"
  }
 },
 "cls": {
  ":scope > header > div > div:nth-child(2) > div:nth-child(2) > div": {
   "w-[70%]": "''"
  },
  ":scope > main > div > div:nth-child(2)": {
   "pt-[0.25rem]": "'pt-[0.75rem]'"
  }
 },
 "tag": {
  ":scope > header > div > button": {
   "to": "a"
  },
  ":scope > header > div > div:nth-child(3)": {
   "to": "button"
  }
 },
 "addClass": {
  ":scope > header > div > div:nth-child(3)": "relative after:absolute after:-inset-1.5 after:content-['']",
  ":scope > main > div > div:nth-child(1) > div:nth-child(2)": "lsn-mid",
  ":scope > main > div > div:nth-child(2)": "relative z-10 lsn-chatp mt-[-3.5rem] rounded-t-[20px] lt:bg-[#F0F4F3] dk:bg-[#091518] px-[0.5rem] pb-[0.75rem]",
  ":scope > main > div > div:nth-child(5) > button": "lsn-gonext",
  ":scope > header > div > div:nth-child(2) > div:nth-child(2)": "lsn-bar",
  ":scope > header > div > button": "lsn-x",
  ":scope > main > div > div:nth-child(4)": "lsn-opts",
  ":scope > main > div > div:nth-child(3)": "lsn-qblk",
  ":scope > main > div > div:nth-child(5)": "lsn-qfoot"
 },
 "after": {
  ":scope > main > div > div:nth-child(1)": "d.duo"
 },
 "repeat": [
  {
   "list": "d.log",
   "as": "r",
   "samples": ":scope > main > div > div:nth-child(2) > div",
   "pick": "r.v",
   "variants": {
    "ama": ":scope > main > div > div:nth-child(2) > div:nth-child(1)",
    "carlos": ":scope > main > div > div:nth-child(2) > div:nth-child(2)"
   },
   "bind": {
    "ama": {
     "addClass": {
      ":scope": "lsn-ln ama lsn-lnA",
      ":scope > div:nth-child(2) > button": "relative after:absolute after:-inset-1.5 after:content-['']"
     },
     "attr": {
      ":scope": {
       "data-who": "'ama'",
       "lang": "'en'"
      },
      ":scope > div:nth-child(2) > button": {
       "type": "'button'",
       "aria-label": "r.play",
       "data-i": "i"
      }
     },
     "html": {
      ":scope > div:nth-child(1) > span": "e(r.name)",
      ":scope > div:nth-child(2) > p": "e(r.en)"
     }
    },
    "carlos": {
     "addClass": {
      ":scope": "lsn-ln carlos lsn-lnC",
      ":scope > div:nth-child(2) > button:nth-child(2)": "relative after:absolute after:-inset-1.5 after:content-['']"
     },
     "attr": {
      ":scope": {
       "data-who": "'carlos'",
       "lang": "'en'"
      },
      ":scope > div:nth-child(2) > button": {
       "type": "'button'",
       "aria-label": "r.play",
       "data-i": "i"
      }
     },
     "html": {
      ":scope > div:nth-child(1) > span": "e(r.name)",
      ":scope > div:nth-child(2) > p": "e(r.en)"
     }
    }
   }
  },
  {
   "list": "d.opts",
   "as": "r",
   "samples": ":scope > main > div > div:nth-child(4) > div",
   "pick": "r.v",
   "variants": {
    "off": ":scope > main > div > div:nth-child(4) > div:nth-child(2)",
    "on": ":scope > main > div > div:nth-child(4) > div:nth-child(1)"
   },
   "bind": {
    "off": {
     "attr": {
      ":scope": {
       "data-o": "r.o"
      }
     },
     "addClass": {
      ":scope": "lsn-opt"
     },
     "html": {
      ":scope > div > span:nth-child(1)": "e(r.k)",
      ":scope > div > span:nth-child(2)": "e(r.t)"
     }
    },
    "on": {
     "attr": {
      ":scope": {
       "data-o": "r.o"
      }
     },
     "addClass": {
      ":scope": "lsn-opt"
     },
     "html": {
      ":scope > div > span:nth-child(1)": "e(r.k)",
      ":scope > div > span:nth-child(2)": "e(r.t)"
     }
    }
   }
  }
 ]
}