 },
 "repeat": [
  {
   "list": "d.opts",
   "as": "r",
   "samples": ":scope > main > div > div:nth-child(4) > button",
   "pick": "r.v",
   "variants": {
    "off": ":scope > main > div > div:nth-child(4) > button:nth-child(1)",
    "on": ":scope > main > div > div:nth-child(4) > button:nth-child(2)"
   },
   "bind": {
    "off": {
     "attr": {
      ":scope": {
       "type": "'button'",
       "data-o": "r.o",
       "aria-pressed": "'false'"
      }
     },
     "addClass": {
      ":scope": "lsn-opt"
     },
     "html": {
      ":scope > div > span": "e(r.k)",
      ":scope > span": "e(r.t)"
     },
     "cls": {
      ":scope": {
       "h-24": "'min-h-[96px]'"
      }
     }
    },
    "on": {
     "attr": {
      ":scope": {
       "type": "'button'",
       "data-o": "r.o",
       "aria-pressed": "'true'"
      }
     },
     "addClass": {
      ":scope": "lsn-opt"
     },
     "html": {
      ":scope > div > span:nth-child(1)": "e(r.k)",
      ":scope > span": "e(r.t)"
     },
     "cls": {
      ":scope": {
       "h-24": "'min-h-[96px]'"
      }
     }
    }
   }
  }
 ],
