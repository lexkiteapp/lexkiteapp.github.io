{
 "_doc": "Hub Từ vựng (#/vocab) – d do HubV2.vocab (web/js/hubs-v2.js) dựng khi cờ ux1 bật. Mẫu brand/stitch/v2/app/hub-vocab (frame-hub tab-vocab). 6 ô cùng khuôn: d.cards (icon + bộ màu r.tint giữ đúng màu từng ô của mẫu). Số liệu mẫu không có thật (8,400 / 36 sets / 850 / 180 / 610 / 5 modes / +45 XP) → ẩn; Lộ trình từ vựng đặt ở chỗ viên \"7 collections\".",
 "compact": true,
 "remove": [
  ":scope > main > header",
  ":scope > main > nav"
 ],
 "repeat": [
  {
   "list": "d.cards",
   "as": "r",
   "samples": ":scope > main > div > section:nth-child(3) > div:nth-child(2) > article",
   "variants": {
    "one": ":scope > main > div > section:nth-child(3) > div:nth-child(2) > article:nth-child(1)"
   },
   "bind": {
    "one": {
     "html": {
      ":scope > div:nth-child(1) > div > span": "e(r.icon)",
      ":scope > div:nth-child(1) > span": "e(r.chip)",
      ":scope > div:nth-child(2) > h3": "e(r.title)",
      ":scope > div:nth-child(2) > p": "e(r.sub)"
     },
     "attr": {
      ":scope": {
       "href": "r.href"
      }
     },
     "cls": {
      ":scope > div:nth-child(1) > div": {
       "lt:bg-[#e6f4f2]": "r.tint[0]",
       "lt:border-[#bfe4df]": "''",
       "lt:shadow-[0_1.5px_0_#d3ede9]": "''"
      },
      ":scope > div:nth-child(1) > div > span": {
       "lt:text-[#00504b]": "r.tint[1]",
       "dk:text-[#6bd8ce]": "''"
      },
      ":scope > div:nth-child(1) > span": {
       "lt:text-[#00504b]": "r.tint[2]",
       "lt:bg-[#e6f4f2]": "''",
       "lt:border-[#c1e5e0]": "''",
       "dk:text-[#6bd8ce]": "''"
      },
      ":scope > div:nth-child(2) > p": {
       "truncate": "'whitespace-normal'"
      }
     },
     "addClass": {
      ":scope > div:nth-child(1) > span": "empty:hidden",
      ":scope > div:nth-child(1) > div > span": "[font-variation-settings:'FILL'_1]"
     },
     "tag": {
      ":scope": {
       "to": "a",
       "addClass": "text-inherit h-auto min-h-[144px]"
      }
     }
    }
   }
  }
 ],
 "text": {
  "28": "d.due",
  "LEXICAL BANK": "d.exam",
  "8,400 words": "d.deckStat",
  "Vocabulary Hub": "t('Từ vựng')",
  "Spaced Repetition": "t('Ôn tập')",
  "+45 XP": "t('Hôm nay')",
  "words due": "t('Cần ôn hôm nay')",
  "IELTS Academic & Core Collocations": "t('Ôn đúng lúc sắp quên giúp nhớ lâu gấp nhiều lần')",
  "Review now": "d.cta",
  "Explore Categories": "t('Khám phá')",
  "7 collections": "t('Lộ trình từ vựng')",
  "Word games": "t('Trò chơi từ vựng')",
  "5 modes": "''",
  "Speed Match, Crossword & Quiz": "t('Ghép thẻ, gõ từ, nghe – gõ, trắc nghiệm')"
 },
 "attr": {
  ":scope > main > div > section:nth-child(2) > button": {
   "href": "d.ctaHref",
   "aria-label": "d.ctaAria"
  },
  ":scope > main > div > section:nth-child(3) > article": {
   "href": "'#/practice'"
  }
 },
 "cls": {
  ":scope > main > div > section:nth-child(2) > button": {
   "h-14": "'min-h-[56px]'"
  }
 },
 "tag": {
  ":scope > main > div > section:nth-child(2) > button": {
   "to": "a",
   "addClass": "text-center"
  },
  ":scope > main > div > section:nth-child(3) > article": {
   "to": "a",
   "addClass": "text-inherit"
  }
 },
 "wrap": {
  ":scope > main > div > section:nth-child(3) > div:nth-child(1) > span": {
   "to": "a",
   "class": "inline-flex items-center min-h-[44px]",
   "attr": {
    "href": "'#/path'"
   }
  }
 },
 "addClass": {
  "span.fill": "[font-variation-settings:'FILL'_1]",
  ":scope > main > div > section:nth-child(3) > article > div:nth-child(1) > div:nth-child(2) > div > span": "empty:hidden"
 }
}
