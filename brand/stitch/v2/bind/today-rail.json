{
 "_doc": "Cột phải máy tính (mẫu desk, cùng HTML today-desk): số liệu · kế hoạch hôm nay · kỳ thi · giải đấu · chuỗi 7 ngày. ux1.js rail() dựng d trên MỌI trang (cột phải cũ), giữ thẻ giải đấu cũ (khách/chưa tham gia) + nút tải app/tiện ích.",
 "src": "today-desk",
 "styles": true,
 "keep": ":scope > div > :nth-child(3)",
 "i18n": {
  "Target": "Mục tiêu điểm",
  "Streak": "Số ngày chuỗi",
  "Total XP": "Tổng XP",
  "Daily goal": "Mục tiêu ngày",
  "Today's plan": "Kế hoạch hôm nay",
  "Readiness level": "Mức sẵn sàng",
  "7-day streak": "Chuỗi 7 ngày"
 },
 "text": {
  "6.5": "d.c.tg",
  "IELTS Academic": "d.c.exName",
  "3 Days": "d.c.streakDays",
  "Flame active": "d.c.flame",
  "220": "d.c.xp",
  "Top 10% today": "d.c.xpToday",
  "12/20": "d.c.goal",
  "8 XP to goal": "d.c.goalLeft",
  "3 goals": "d.p.count",
  "1/3": "d.p.done",
  "IELTS Target 6.5": "d.x.title2",
  "42 days left": "d.x.left",
  "Ready 38%": "d.x.ready",
  "Mock test · 20 min": "d.x.mock",
  "Silver league": "d.lg.tier",
  "#4 of 30": "d.lg.rank",
  "▲ Promotion zone": "d.lg.zone",
  "2d left": "d.lg.left",
  "3/7 completed": "d.wk.n2"
 },
 "attr": {
  ":scope > div > aside:nth-of-type(2) > div:nth-child(1) > div > div:nth-child(1)": {
   "href": "d.c.tgHref"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(1) > div > div:nth-child(2)": {
   "href": "'#/streak'"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(1) > div > div:nth-child(3)": {
   "href": "'#/stats'"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(1) > div > div:nth-child(4)": {
   "href": "'#/review'"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(2)": {
   "data-show": "d.p.items.length ? 1 : 0",
   "data-blk": "'plan'"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(3)": {
   "data-blk": "'exam'"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(3) > div:nth-child(1) > span": {
   "data-show": "d.x.left ? 1 : 0"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(3) > div:nth-child(2)": {
   "data-show": "d.x.p != null ? 1 : 0"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(3) > div:nth-child(2) > div:nth-child(2) > div": {
   "style": "'width:' + (d.x.p || 0) + '%'",
   "role": "'progressbar'",
   "aria-valuenow": "d.x.p || 0",
   "aria-valuemin": "0",
   "aria-valuemax": "100",
   "aria-label": "t('Mức sẵn sàng')"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(3) > button": {
   "data-href": "d.x.href"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(4)": {
   "href": "'#/league'",
   "data-lg": "'card'"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(4) > div:nth-child(1) > div:nth-child(2) > div > span:nth-child(1)": {
   "data-lg": "'tier'"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(4) > div:nth-child(1) > div:nth-child(2) > div > span:nth-child(2)": {
   "data-lg": "'rank'"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(4) > div:nth-child(1) > div:nth-child(2) > p": {
   "data-lg": "'zone'"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(4) > span": {
   "data-lg": "'left'"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(5)": {
   "href": "'#/streak'",
   "data-blk": "'week'"
  }
 },
 "cls": {
  ":scope > div > aside:nth-of-type(2) > div:nth-child(3) > div:nth-child(2) > div:nth-child(2) > div": {
   "[width:38%]": "''"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(4)": {
   "flex": "d.lg.tier ? 'flex' : 'hidden'"
  },
  ":scope > div > aside:nth-of-type(2)": {
   "w-[320px]": "'w-full'",
   "py-8": "''",
   "pr-8": "''"
  }
 },
 "tag": {
  ":scope > div > aside:nth-of-type(2) > div:nth-child(1) > div > div:nth-child(1)": {
   "to": "a"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(1) > div > div:nth-child(2)": {
   "to": "a"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(1) > div > div:nth-child(3)": {
   "to": "a"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(1) > div > div:nth-child(4)": {
   "to": "a"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(4)": {
   "to": "a"
  },
  ":scope > div > aside:nth-of-type(2) > div:nth-child(5)": {
   "to": "a"
  },
  ":scope > div > aside:nth-of-type(2)": {
   "to": "div"
  }
 },
 "repeat": [
  {
   "list": "d.p.items",
   "as": "r",
   "variants": {
    "cur": ":scope > div > aside:nth-of-type(2) > div:nth-child(2) > div:nth-child(2) > div:nth-child(1)",
    "row": ":scope > div > aside:nth-of-type(2) > div:nth-child(2) > div:nth-child(2) > div:nth-child(2)",
    "lis": ":scope > div > aside:nth-of-type(2) > div:nth-child(2) > div:nth-child(2) > div:nth-child(3)"
   },
   "samples": ":scope > div > aside:nth-of-type(2) > div:nth-child(2) > div:nth-child(2) > div",
   "pick": "r.v",
   "bind": {
    "cur": {
     "text": {
      "Fix common mistakes": "r.t",
      "Current": "r.tag"
     },
     "attr": {
      ":scope": {
       "href": "r.href",
       "title": "r.sub"
      }
     },
     "tag": {
      ":scope": {
       "to": "a"
      }
     },
     "addClass": {
      ":scope": "relative after:absolute after:-inset-y-1 after:inset-x-0 after:content-['']"
     }
    },
    "row": {
     "text": {
      "Review 8 words due": "r.t",
      "Spaced": "r.tag"
     },
     "attr": {
      ":scope": {
       "href": "r.href",
       "title": "r.sub"
      }
     },
     "tag": {
      ":scope": {
       "to": "a"
      }
     },
     "addClass": {
      ":scope": "relative after:absolute after:-inset-y-1 after:inset-x-0 after:content-['']"
     }
    },
    "lis": {
     "text": {
      "1-min listening drill": "r.t",
      "Sprint": "r.tag"
     },
     "attr": {
      ":scope": {
       "href": "r.href",
       "title": "r.sub"
      }
     },
     "tag": {
      ":scope": {
       "to": "a"
      }
     },
     "addClass": {
      ":scope": "relative after:absolute after:-inset-y-1 after:inset-x-0 after:content-['']"
     }
    }
   }
  },
  {
   "list": "d.wk.days",
   "as": "x",
   "variants": {
    "done": ":scope > div > aside:nth-of-type(2) > div:nth-child(5) > div:nth-child(2) > div:nth-child(1)",
    "now": ":scope > div > aside:nth-of-type(2) > div:nth-child(5) > div:nth-child(2) > div:nth-child(3)",
    "off": ":scope > div > aside:nth-of-type(2) > div:nth-child(5) > div:nth-child(2) > div:nth-child(4)"
   },
   "samples": ":scope > div > aside:nth-of-type(2) > div:nth-child(5) > div:nth-child(2) > div",
   "pick": "x.v",
   "bind": {
    "done": {
     "text": {
      "M": "x.l"
     },
     "attr": {
      ":scope": {
       "title": "x.aria"
      }
     }
    },
    "now": {
     "text": {
      "W": "x.l"
     },
     "attr": {
      ":scope": {
       "title": "x.aria"
      }
     }
    },
    "off": {
     "text": {
      "T": "x.l"
     },
     "attr": {
      ":scope": {
       "title": "x.aria"
      }
     }
    }
   }
  }
 ]
}