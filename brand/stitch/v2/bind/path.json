{
 "_doc": "Bản đồ gắn dữ liệu màn Học (Learning Path) – d do ux1.js map() dựng (d.hdr, d.unit, d.nodes, d.tabs…). Đầu trang + thanh tab của màn này là CHUẨN CHUNG (shell.js).",
 "shell": true,
 "i18n": {
  "Guide": "Hướng dẫn chặng",
  "Progress": "Tiến độ"
 },
 "text": {
  "IELTS": "d.hdr.exam",
  "14": "d.hdr.streak",
  "820": "d.hdr.xp",
  "14/20": "d.hdr.goal",
  "See full path →": "d.ph.more"
 },
 "attr": {
  ":scope > main > div:nth-child(1)": {
   "data-pv": "'1'",
   "id": "'v2-pathlist'"
  },
  ":scope > main > div:nth-child(2) > button": {
   "data-act": "'pathx'",
   "aria-expanded": "d.ph.open",
   "aria-controls": "'v2-pathlist'"
  },
  ":scope > header > div > div:nth-child(2)": {
   "href": "'#/me'",
   "aria-label": "t('Tài khoản')"
  }
 },
 "cls": {},
 "tag": {
  ":scope > header > div > div:nth-child(2)": {
   "to": "a",
   "addClass": "relative after:absolute after:-inset-1.5 after:content-['']"
  }
 },
 "repeat": [
  {
   "list": "d.rows",
   "as": "r",
   "variants": {
    "head": ":scope > main > div:nth-child(1) > div:nth-child(1)",
    "done": ":scope > main > div:nth-child(1) > div:nth-child(2)",
    "cur": ":scope > main > div:nth-child(1) > div:nth-child(4)",
    "lock": ":scope > main > div:nth-child(1) > div:nth-child(5)",
    "chk": ":scope > main > div:nth-child(1) > div:nth-child(7)"
   },
   "samples": ":scope > main > div:nth-child(1) > div",
   "pick": "r.v",
   "bind": {
    "head": {
     "text": {
      "Stage 1": "r.stage",
      "Greetings and your day": "r.unit",
      "You can greet people and talk about your day": "r.can",
      "2/6 lessons": "r.of"
     },
     "attr": {
      ":scope > div:nth-child(1) > button": {
       "data-act": "'guide'",
       "aria-haspopup": "'dialog'"
      },
      ":scope > div:nth-child(4) > div:nth-child(1) > div": {
       "style": "'width:' + r.pct + '%'",
       "role": "'progressbar'",
       "aria-valuenow": "r.pct",
       "aria-valuemin": "0",
       "aria-valuemax": "100",
       "aria-label": "r.of"
      }
     },
     "cls": {
      ":scope > div:nth-child(1) > button": {
       "flex": "r.guide ? 'flex' : 'hidden'"
      }
     }
    },
    "done": {
     "text": {
      "Greetings, introducing yourself": "r.label",
      "Asking names": "r.sub"
     },
     "attr": {
      ":scope": {
       "style": "'height:' + r.h + 'px'",
       "data-pr": "r.id"
      },
      ":scope > button": {
       "style": "'inset-inline-start:' + (r.x - 28) + 'px;top:' + (r.cy - 28) + 'px'",
       "aria-label": "r.aria",
       "aria-haspopup": "'dialog'"
      },
      ":scope > svg": {
       "height": "r.h",
       "viewBox": "'0 0 88 ' + r.h"
      },
      ":scope > svg > path:nth-child(1)": {
       "d": "r.pin"
      },
      ":scope > svg > path:nth-child(2)": {
       "d": "r.pout"
      },
      ":scope > div:nth-child(3)": {
       "style": "'top:' + r.cy + 'px'"
      }
     }
    },
    "cur": {
     "text": {
      "Speak: tell about your day": "r.label",
      "Lunch, evening, bedtime": "r.sub",
      "3 min": "r.min",
      "Start": "r.start"
     },
     "attr": {
      ":scope": {
       "style": "'height:' + r.h + 'px'",
       "data-pr": "r.id"
      },
      ":scope > button": {
       "style": "'inset-inline-start:' + (r.x - 36) + 'px;top:' + (r.cy - 36) + 'px'",
       "aria-label": "r.aria",
       "aria-haspopup": "'dialog'"
      },
      ":scope > svg": {
       "height": "r.h",
       "viewBox": "'0 0 88 ' + r.h"
      },
      ":scope > svg > path:nth-child(1)": {
       "d": "r.pin"
      },
      ":scope > svg > path:nth-child(2)": {
       "d": "r.pout"
      },
      ":scope > button > span > svg > circle:nth-child(2)": {
       "stroke-dashoffset": "r.off"
      },
      ":scope > div:nth-child(3) > div:nth-child(4) > button": {
       "data-href": "r.href",
       "data-cur": "'1'",
       "aria-label": "r.start"
      }
     },
     "html": {
      ":scope > div:nth-child(3) > div:nth-child(5)": "r.tch"
     }
    },
    "lock": {
     "text": {
      "Story: the new neighbour": "r.label",
      "Moving in": "r.sub"
     },
     "attr": {
      ":scope": {
       "style": "'height:' + r.h + 'px'",
       "data-pr": "r.id"
      },
      ":scope > button": {
       "style": "'inset-inline-start:' + (r.x - 28) + 'px;top:' + (r.cy - 28) + 'px'",
       "aria-label": "r.aria",
       "aria-haspopup": "'dialog'"
      },
      ":scope > svg": {
       "height": "r.h",
       "viewBox": "'0 0 88 ' + r.h"
      },
      ":scope > svg > path:nth-child(1)": {
       "d": "r.pin"
      },
      ":scope > svg > path:nth-child(2)": {
       "d": "r.pout"
      },
      ":scope > div:nth-child(3)": {
       "style": "'top:' + r.cy + 'px'"
      }
     }
    },
    "chk": {
     "text": {
      "Check: a day": "r.label",
      "Short sentences": "r.sub"
     },
     "attr": {
      ":scope": {
       "style": "'height:' + r.h + 'px'",
       "data-pr": "r.id"
      },
      ":scope > button": {
       "style": "'inset-inline-start:' + (r.x - 28) + 'px;top:' + (r.cy - 28) + 'px'",
       "aria-label": "r.aria",
       "aria-haspopup": "'dialog'"
      },
      ":scope > svg": {
       "height": "r.h",
       "viewBox": "'0 0 88 ' + r.h"
      },
      ":scope > svg > path:nth-child(1)": {
       "d": "r.pin"
      },
      ":scope > svg > path:nth-child(2)": {
       "d": "r.pout"
      },
      ":scope > div:nth-child(3)": {
       "style": "'top:' + r.cy + 'px'"
      }
     }
    }
   }
  },
  {
   "list": "d.tabs",
   "as": "x",
   "variants": {
    "on": ":scope > nav > div > a:nth-child(1)",
    "off": ":scope > nav > div > a:nth-child(2)"
   },
   "samples": ":scope > nav > div > a",
   "pick": "x.on ? 'on' : 'off'",
   "bind": {
    "on": {
     "text": {
      "Learn": "x.label"
     },
     "html": {
      "span.material-symbols-outlined": "x.icon"
     },
     "attr": {
      ":scope": {
       "href": "x.href",
       "data-tab": "x.k"
      }
     }
    },
    "off": {
     "text": {
      "Review": "x.label"
     },
     "html": {
      "span.material-symbols-outlined": "x.icon"
     },
     "attr": {
      ":scope": {
       "href": "x.href",
       "data-tab": "x.k"
      }
     }
    }
   }
  }
 ],
 "addClass": {
  ":scope > header > div > div:nth-child(1)": "min-w-0 max-[374px]:gap-1",
  ":scope > header > div > div:nth-child(1) > div": "max-[374px]:px-2 max-[374px]:gap-1"
 },
 "_contrast": "Sửa tương phản (chỉ màu, lấy từ Stitch): icon sao nút vàng bản sáng = #261A00 như bản tối Stitch; icon sách dải chặng bản tối = #4FD1C5 (màu sửa tương phản Stitch v2.1).",
 "html": {
  ":scope > header > div > div:nth-child(1) > div:nth-child(2) > span:nth-child(1)": "ST2.flame(ST2.flameState(d.hdr.streak), 20)"
 },
 "wrap": {
  ":scope > header > div > div:nth-child(1) > div:nth-child(1)": {
   "to": "a",
   "class": "flex items-center justify-center min-h-[44px] min-w-[44px]",
   "attr": {
    "href": "'#/goal'",
    "aria-label": "t('Mức sẵn sàng thi') + ': ' + d.hdr.exam",
    "data-hdr": "'exam'"
   }
  },
  ":scope > header > div > div:nth-child(1) > div:nth-child(2)": {
   "to": "a",
   "class": "flex items-center justify-center min-h-[44px] min-w-[44px]",
   "attr": {
    "href": "'#/streak'",
    "aria-label": "t('Chuỗi ngày học') + ': ' + d.hdr.streak",
    "data-hdr": "'streak'"
   }
  },
  ":scope > header > div > div:nth-child(1) > div:nth-child(3)": {
   "to": "a",
   "class": "flex items-center justify-center min-h-[44px] min-w-[44px]",
   "attr": {
    "href": "'#/league'",
    "aria-label": "t('Tổng XP') + ': ' + d.hdr.xp",
    "data-hdr": "'xp'"
   }
  },
  ":scope > header > div > div:nth-child(1) > div:nth-child(4)": {
   "to": "a",
   "class": "flex items-center justify-center min-h-[44px] min-w-[44px]",
   "attr": {
    "href": "'#/stats'",
    "aria-label": "t('Mục tiêu hôm nay') + ': ' + d.hdr.goal",
    "data-hdr": "'goal'"
   }
  }
 }
}
