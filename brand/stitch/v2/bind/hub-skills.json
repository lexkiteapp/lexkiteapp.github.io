{
 "_doc": "Hub Kỹ năng (#/skills) – d do HubV2.skills (web/js/hubs-v2.js). Mẫu brand/stitch/v3/app/hub-skills (trường ref của coverage; cặp v2/app lệch cấu trúc thẻ 84 %). Thẻ trên cùng = Khóa học (#/courses) + Ama; 4 thẻ kỹ năng → #/skill/<k> (1 khuôn + r.tint), kỹ năng kỳ thi không thi → dòng ghi chú d.off; hàng dưới cùng khuôn = Ngữ pháp, Phát âm, Luyện, Sổ lỗi sai, Thi thử. Số liệu mẫu không có dữ liệu thật (42 audio drills, Progress 72 %, 18 sounds) → gỡ; band = lần thi thử gần nhất; số bài đã làm = game.*Done.",
 "styles": true,
 "compact": true,
 "remove": [
  ":scope > header",
  ":scope > nav"
 ],
 "repeat": [
  {
   "list": "d.skills",
   "as": "r",
   "samples": ":scope > main > section:nth-child(2) > div:nth-child(2) > article",
   "variants": {
    "one": ":scope > main > section:nth-child(2) > div:nth-child(2) > article:nth-child(1)"
   },
   "bind": {
    "one": {
     "html": {
      ":scope > div:nth-child(1) > div > div > span": "e(r.icon)",
      ":scope > div:nth-child(1) > h3": "e(r.name)",
      ":scope > div:nth-child(1) > p": "e(r.sub)",
      ":scope > div:nth-child(1) > div > span": "e(r.band)",
      ":scope > div:nth-child(2) > div:nth-child(1)": "e(r.done)"
     },
     "attr": {
      ":scope": {
       "href": "r.href"
      }
     },
     "cls": {
      ":scope > div:nth-child(1) > div > div": {
       "lt:bg-[#a4f1e7]": "r.tint",
       "lt:text-[#00504b]": "''",
       "lt:border-[#00504b]": "''",
       "dk:text-[#2DD4BF]": "''"
      },
      ":scope > div:nth-child(2) > div:nth-child(1)": {
       "truncate": "'whitespace-normal'",
       "inline-block": "'self-start'"
      }
     },
     "addClass": {
      ":scope > div:nth-child(1) > div > span": "empty:hidden",
      ":scope > div:nth-child(2) > div:nth-child(1)": "empty:hidden"
     },
     "tag": {
      ":scope": {
       "to": "a",
       "addClass": "text-inherit"
      }
     },
     "remove": [
      ":scope > div:nth-child(2) > div:nth-child(3)",
      ":scope > div:nth-child(2) > div:nth-child(2)"
     ]
    }
   }
  },
  {
   "list": "d.rows",
   "as": "r",
   "samples": ":scope > main > section:nth-child(3) > div:nth-child(2) > div",
   "variants": {
    "one": ":scope > main > section:nth-child(3) > div:nth-child(2) > div:nth-child(1)"
   },
   "bind": {
    "one": {
     "html": {
      ":scope > div:nth-child(1) > div:nth-child(1) > span": "e(r.icon)",
      ":scope > div:nth-child(1) > div:nth-child(2) > h3": "e(r.title)",
      ":scope > div:nth-child(1) > div:nth-child(2) > p": "e(r.sub)",
      ":scope > button > span:nth-child(1)": "e(t('Mở'))"
     },
     "attr": {
      ":scope > button": {
       "href": "r.href",
       "aria-label": "r.title"
      }
     },
     "cls": {
      ":scope > div:nth-child(1) > div:nth-child(1)": {
       "lt:bg-[#a4f1e7]": "r.tint",
       "lt:text-[#00504b]": "''",
       "lt:border-[#00504b]": "''",
       "dk:text-[#2DD4BF]": "''"
      },
      ":scope > div:nth-child(1) > div:nth-child(2) > h3": {
       "truncate": "'whitespace-normal'"
      },
      ":scope > div:nth-child(1) > div:nth-child(2) > p": {
       "line-clamp-2": "''"
      }
     },
     "tag": {
      ":scope > button": {
       "to": "a"
      }
     }
    }
   }
  }
 ],
 "html": {
  ":scope > main > section:nth-child(1) > div > div:nth-child(1) > div > span:nth-child(2)": "e(t('Kỹ năng'))",
  ":scope > main > section:nth-child(1) > div > div:nth-child(1) > span": "e(d.exam)",
  ":scope > main > section:nth-child(1) > div > div:nth-child(2) > div:nth-child(1) > h1": "e(t('Khóa học theo lộ trình'))",
  ":scope > main > section:nth-child(1) > div > div:nth-child(2) > div:nth-child(1) > p": "e(t('Học theo chương, tự đánh dấu hoàn thành, luôn biết bài tiếp theo'))",
  ":scope > main > section:nth-child(1) > div > div:nth-child(2) > div:nth-child(2) > div:nth-child(1)": "d.teacher",
  ":scope > main > section:nth-child(1) > div > div:nth-child(2) > div:nth-child(2) > div:nth-child(2)": "'Ama'",
  ":scope > main > section:nth-child(1) > div > div:nth-child(3) > p": "e(t('Luyện từng kỹ năng theo đúng dạng bài của kỳ thi bạn chọn.'))",
  ":scope > main > section:nth-child(1) > div > button > span:nth-child(1)": "e(t('Bắt đầu'))",
  ":scope > main > section:nth-child(2) > div:nth-child(1) > div > h2": "e(t('Kỹ năng'))",
  ":scope > main > section:nth-child(2) > div:nth-child(1) > div > p": "e(d.sub)",
  ":scope > main > section:nth-child(2) > div:nth-child(1) > span": "e(d.exam) + \" · \" + e(t(\"Đổi\"))",
  ":scope > main > section:nth-child(3) > div:nth-child(1) > div > h2": "e(t('Luyện'))",
  ":scope > main > section:nth-child(3) > div:nth-child(1) > div > p": "e(t('Mọi bài luyện theo nhóm, luyện thi trước'))"
 },
 "attr": {
  ":scope > main > section:nth-child(1) > div > div:nth-child(2) > div:nth-child(2) > div:nth-child(1)": {
   "aria-label": "''",
   "aria-hidden": "'true'"
  },
  ":scope > main > section:nth-child(1) > div > button": {
   "href": "'#/courses'"
  },
  ":scope > main > section:nth-child(2) > div:nth-child(1) > span": {
   "data-exam-pick": "'1'",
   "type": "'button'",
   "aria-label": "t('Kỳ thi của bạn') + ': ' + d.exam"
  }
 },
 "tag": {
  ":scope > main > section:nth-child(1) > div > button": {
   "to": "a"
  },
  ":scope > main > section:nth-child(2) > div:nth-child(1) > span": {
   "to": "button",
   "addClass": "min-h-[44px] flex-none"
  }
 },
 "after": {
  ":scope > main > section:nth-child(2) > div:nth-child(2)": "d.off"
 },
 "cls": {
  ":scope": {
   "lt:overflow-hidden": "''"
  }
 }
}
