      },
      ":scope > span:nth-child(3)": {
       "lt:text-[#F2553B]": "'lt:text-[#B53A22]'"
      }
     },
     "tag": {
      ":scope": {
       "to": "label",
       "addClass": "relative focus-within:ring-2 focus-within:ring-[#2BA39A]"
      }
