       "dk:text-[#475569]": "r.stars[2].on ? 'dk:text-[#f59e0b]' : 'dk:text-[#475569]'"
      }
     },
     "tag": {
      ":scope": {
       "to": "button"
      }
     }
    },
    "todo": {
     "html": {
      ":scope > span": "e(r.label)"
     },
     "attr": {
      ":scope": {
       "type": "'button'",
       "data-href": "r.href",
       "role": "'listitem'"
      },
      ":scope > div:nth-child(3)": {
       "role": "'img'",
       "aria-label": "r.starsAria"
      }
     },
     "cls": {
      ":scope > div:nth-child(3) > span:nth-child(1)": {
       "lt:text-[#D1C3B4]": "r.stars[0].on ? 'lt:text-[#F59E0B]' : 'lt:text-[#D1C3B4]'",
       "dk:text-[#475569]": "r.stars[0].on ? 'dk:text-[#f59e0b]' : 'dk:text-[#475569]'"
      },
      ":scope > div:nth-child(3) > span:nth-child(2)": {
