       "dk:text-[#f59e0b]": "r.stars[0].on ? 'dk:text-[#f59e0b]' : 'dk:text-[#475569]'"
      },
      ":scope > div:nth-child(3) > span:nth-child(2)": {
       "lt:text-[#F59E0B]": "r.stars[1].on ? 'lt:text-[#F59E0B]' : 'lt:text-[#D1C3B4]'",
       "dk:text-[#f59e0b]": "r.stars[1].on ? 'dk:text-[#f59e0b]' : 'dk:text-[#475569]'"
      },
      ":scope > div:nth-child(3) > span:nth-child(3)": {
       "lt:text-[#F59E0B]": "r.stars[2].on ? 'lt:text-[#F59E0B]' : 'lt:text-[#D1C3B4]'",
       "dk:text-[#f59e0b]": "r.stars[2].on ? 'dk:text-[#f59e0b]' : 'dk:text-[#475569]'"
      }
     },
