 "repeat": [
  {
   "list": "d.nodes",
   "as": "r",
   "samples": ":scope > div > main > section:nth-child(2) > div:nth-child(2) > div:nth-child(2) > div",
   "pick": "r.st",
   "variants": {
    "done": ":scope > div > main > section:nth-child(2) > div:nth-child(2) > div:nth-child(2) > div:nth-child(1)",
    "cur": ":scope > div > main > section:nth-child(2) > div:nth-child(2) > div:nth-child(2) > div:nth-child(3)",
    "todo": ":scope > div > main > section:nth-child(2) > div:nth-child(2) > div:nth-child(2) > div:nth-child(4)"
   },
   "bind": {
    "done": {
     "html": {
      ":scope > span": "e(r.label)"
     },
     "attr": {
      ":scope": {
       "type": "'button'",
       "data-href": "r.href",
       "role": "'listitem'"
      },
      ":scope > div:nth-child(3)": {
       "role": "'img'",
       "aria-label": "r.starsAria"
      }
     },
     "cls": {
      ":scope > div:nth-child(3) > span:nth-child(1)": {
       "text-[#F59E0B]": "r.stars[0].on ? 'text-[#F59E0B]' : 'text-[#D1C3B4]'"
      },
      ":scope > div:nth-child(3) > span:nth-child(2)": {
       "text-[#F59E0B]": "r.stars[1].on ? 'text-[#F59E0B]' : 'text-[#D1C3B4]'"
      },
      ":scope > div:nth-child(3) > span:nth-child(3)": {
       "text-[#F59E0B]": "r.stars[2].on ? 'text-[#F59E0B]' : 'text-[#D1C3B4]'"
      }
     },
     "tag": {
      ":scope": {
       "to": "button"
      }
     }
    },
    "cur": {
     "html": {
      ":scope > span": "e(r.label)"
     },
     "attr": {
      ":scope": {
       "type": "'button'",
       "data-href": "r.href",
       "role": "'listitem'",
       "aria-current": "'step'"
      },
      ":scope > div:nth-child(3)": {
       "role": "'img'",
       "aria-label": "r.starsAria"
      }
     },
     "cls": {
      ":scope > div:nth-child(3) > span:nth-child(1)": {
       "text-[#F59E0B]": "r.stars[0].on ? 'text-[#F59E0B]' : 'text-[#D1C3B4]'"
      },
      ":scope > div:nth-child(3) > span:nth-child(2)": {
       "text-[#D1C3B4]": "r.stars[1].on ? 'text-[#F59E0B]' : 'text-[#D1C3B4]'"
      },
      ":scope > div:nth-child(3) > span:nth-child(3)": {
       "text-[#D1C3B4]": "r.stars[2].on ? 'text-[#F59E0B]' : 'text-[#D1C3B4]'"
      }
     },
     "tag": {
      ":scope": {
       "to": "button"
      }
     }
    },
    "todo": {
     "html": {
      ":scope > span": "e(r.label)"
     },
     "attr": {
      ":scope": {
       "type": "'button'",
       "data-href": "r.href",
       "role": "'listitem'"
      },
      ":scope > div:nth-child(3)": {
       "role": "'img'",
       "aria-label": "r.starsAria"
      }
     },
     "cls": {
      ":scope > div:nth-child(3) > span:nth-child(1)": {
       "text-[#D1C3B4]": "r.stars[0].on ? 'text-[#F59E0B]' : 'text-[#D1C3B4]'"
      },
      ":scope > div:nth-child(3) > span:nth-child(2)": {
       "text-[#D1C3B4]": "r.stars[1].on ? 'text-[#F59E0B]' : 'text-[#D1C3B4]'"
      },
      ":scope > div:nth-child(3) > span:nth-child(3)": {
       "text-[#D1C3B4]": "r.stars[2].on ? 'text-[#F59E0B]' : 'text-[#D1C3B4]'"
      }
     },
     "tag": {
      ":scope": {
       "to": "button"
      }
     }
    }
   }
  },
  {
   "list": "d.nodes",
   "as": "r",
   "samples": ":scope > div > main > section:nth-child(3) > div:nth-child(2) > div:nth-child(n+4)",
   "pick": "r.st === 'cur' ? 'cur' : 'todo'",
   "variants": {
    "cur": ":scope > div > main > section:nth-child(3) > div:nth-child(2) > div:nth-child(4)",
    "todo": ":scope > div > main > section:nth-child(3) > div:nth-child(2) > div:nth-child(5)"
   },
   "bind": {
    "cur": {
     "html": {
      ":scope > span": "e(r.label)"
     },
     "attr": {
      ":scope": {
       "type": "'button'",
       "data-href": "r.href",
       "aria-current": "'step'"
      },
      ":scope > div:nth-child(3)": {
       "role": "'img'",
       "aria-label": "r.starsAria"
      }
     },
     "cls": {
      ":scope > div:nth-child(3) > span:nth-child(1)": {
       "text-[#f4bf40]": "r.stars[0].on ? 'text-[#f4bf40]' : 'text-[#3d4947]'",
       "material-symbols-fill": "r.stars[0].on ? 'material-symbols-fill' : 'material-symbols-outlined'"
      },
      ":scope > div:nth-child(3) > span:nth-child(2)": {
       "text-[#3d4947]": "r.stars[1].on ? 'text-[#f4bf40] material-symbols-fill' : 'text-[#3d4947]'"
      },
      ":scope > div:nth-child(3) > span:nth-child(3)": {
       "text-[#3d4947]": "r.stars[2].on ? 'text-[#f4bf40] material-symbols-fill' : 'text-[#3d4947]'"
      }
     },
     "tag": {
      ":scope": {
       "to": "button"
      }
     }
    },
    "todo": {
     "html": {
      ":scope > span": "e(r.label)",
      ":scope > div:nth-child(1) > span": "r.st === 'done' ? 'check' : 'lock'"
     },
     "attr": {
      ":scope": {
       "type": "'button'",
       "data-href": "r.href"
      },
      ":scope > div:nth-child(3)": {
       "role": "'img'",
       "aria-label": "r.starsAria"
      }
     },
     "cls": {
      ":scope": {
       "opacity-70": "r.st === 'done' ? 'opacity-100' : 'opacity-70'"
      },
      ":scope > div:nth-child(3) > span:nth-child(1)": {
       "text-[11px]": "r.stars[0].on ? 'text-[11px] text-[#f4bf40] material-symbols-fill' : 'text-[11px]'"
      },
      ":scope > div:nth-child(3) > span:nth-child(2)": {
       "text-[11px]": "r.stars[1].on ? 'text-[11px] text-[#f4bf40] material-symbols-fill' : 'text-[11px]'"
      },
      ":scope > div:nth-child(3) > span:nth-child(3)": {
       "text-[11px]": "r.stars[2].on ? 'text-[11px] text-[#f4bf40] material-symbols-fill' : 'text-[11px]'"
      }
     },
     "tag": {
      ":scope": {
       "to": "button"
      }
     }
