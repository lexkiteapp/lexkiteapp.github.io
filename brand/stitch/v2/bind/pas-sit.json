  ":scope > div > nav > a:nth-of-type(5) > span": "e(d.tabsNav[4].label)",
  ":scope > div > nav > a:nth-of-type(2) > div > span": "''",
  ":scope > div > nav > button:nth-of-type(1) > span:last-child": "e(d.tabsNav[0].label)",
  ":scope > div > nav > button:nth-of-type(2) > span:last-child": "e(d.tabsNav[1].label)",
  ":scope > div > nav > button:nth-of-type(3) > span:last-child": "e(d.tabsNav[2].label)",
  ":scope > div > nav > button:nth-of-type(4) > span:last-child": "e(d.tabsNav[3].label)",
  ":scope > div > nav > button:nth-of-type(5) > span:last-child": "e(d.tabsNav[4].label)",
  ":scope > div > nav > button:nth-of-type(2) > div > span:nth-child(2)": "''",
  ":scope > div > main > section:nth-child(5) > div:nth-child(3) > div:nth-child(1)": "''"
 },
