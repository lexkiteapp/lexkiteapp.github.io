  "Weekly goal 32 / 50 sentences": "d.week",
  "4 phrases remaining": "d.remain"
 },
 "html": {
  ":scope > div > main > div:nth-child(1) > div:nth-child(1)": "d.teacher",
  ":scope > div > main > div:nth-child(1) > div:nth-child(2) > p": "e(d.mission)",
  ":scope > div > main > section:nth-child(4) > div:nth-child(3) > span:nth-child(1)": "''",
  ":scope > div > nav > a:nth-of-type(1) > span:last-child": "e(d.tabsNav[0].label)",
  ":scope > div > nav > a:nth-of-type(2) > span:last-child": "e(d.tabsNav[1].label)",
  ":scope > div > nav > a:nth-of-type(3) > span:last-child": "e(d.tabsNav[2].label)",
  ":scope > div > nav > a:nth-of-type(4) > span:last-child": "e(d.tabsNav[3].label)",
  ":scope > div > nav > a:nth-of-type(5) > span:last-child": "e(d.tabsNav[4].label)"
 },
 "attr": {
  ":scope > div > header > div > button": {
   "type": "'button'",
   "data-href": "d.back"
  },
  ":scope > div > header > button": {
   "type": "'button'",
   "id": "'spkInfo'",
   "aria-label": "d.info",
   "title": "d.info"
  },
  ":scope > div > main > div:nth-child(1) > div:nth-child(1)": {
   "aria-hidden": "'true'"
  },
  ":scope > div > main > section:nth-child(2) > div:nth-child(2) > div:nth-child(2)": {
   "role": "'list'",
   "aria-label": "d.stage"
  },
  ":scope > div > main > section:nth-child(4) > div:nth-child(2)": {
   "role": "'progressbar'",
   "aria-valuemin": "0",
   "aria-valuemax": "100",
   "aria-valuenow": "d.pct",
   "aria-valuetext": "d.mastered + ' ' + d.masteredSub",
   "aria-label": "d.masteredSub"
  },
  ":scope > div > main > section:nth-child(4) > div:nth-child(2) > div:nth-child(1)": {
   "style": "'--p:' + d.pct + '%'"
  },
  ":scope > div > main > div:nth-child(6) > button:nth-child(1)": {
   "type": "'button'",
   "data-href": "d.start"
  },
  ":scope > div > main > div:nth-child(6) > button:nth-child(2)": {
   "type": "'button'",
   "data-href": "d.rp"
  },
  ":scope > div > nav > a:nth-of-type(1)": {
   "href": "d.tabsNav[0].href"
  },
  ":scope > div > nav > a:nth-of-type(2)": {
   "href": "d.tabsNav[1].href"
  },
  ":scope > div > nav > a:nth-of-type(3)": {
   "href": "d.tabsNav[2].href",
   "aria-current": "d.tabsNav[2].on ? 'page' : 'false'"
  },
  ":scope > div > nav > a:nth-of-type(4)": {
   "href": "d.tabsNav[3].href"
  },
  ":scope > div > nav > a:nth-of-type(5)": {
   "href": "d.tabsNav[4].href"
  }
 },
 "cls": {
  ":scope > div > main > section:nth-child(2) > div:nth-child(2) > div:nth-child(2)": {
   "grid-cols-5": "d.nodes.length >= 5 ? 'grid-cols-5' : d.nodes.length === 4 ? 'grid-cols-4' : 'grid-cols-3'"
  },
  ":scope > div > main > section:nth-child(4) > div:nth-child(2) > div:nth-child(1)": {
   "[width:66.6%]": "'[width:var(--p)]'"
  },
  ":scope > div > main > section:nth-child(5)": {
   "rounded-[16px]": "d.addonOn ? 'rounded-[16px]' : 'hidden'"
  },
  ":scope > div > main > div:nth-child(6) > button:nth-child(1) > svg": {
   "dk:hidden": "''"
  }
 },
 "remove": [
  ":scope > div > main > div:nth-child(1) > div:nth-child(2) > div:nth-child(5)",
  ":scope > div > main > section:nth-child(5) > div:nth-child(1) > span:nth-child(2)",
  ":scope > div > nav > a:nth-of-type(2) > div > span"
 ],
 "repeat": [
  {
   "list": "d.nodes",
   "as": "r",
   "samples": ":scope > div > main > section:nth-child(2) > div:nth-child(2) > div:nth-child(2) > div",
