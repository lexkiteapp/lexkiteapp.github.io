  ":scope > div > main > section:nth-child(4) > div:nth-child(3) > div:nth-child(2) > div:nth-child(2) > span:nth-child(2)": "e((d.tasks[1] || {}).ex || '')",
  ":scope > div > main > section:nth-child(4) > div:nth-child(3) > span:nth-child(3)": "'<span class=\"dk:hidden\">' + e(d.remain) + '</span><span class=\"lt:hidden\">' + e(d.tasks[1] ? (d.tasks[1].done ? t('Đã xong') : t('Mục tiêu nói')) : '') + '</span>'",
  ":scope > div > main > section:nth-child(4) > div:nth-child(4) > div:nth-child(1) > div:nth-child(2) > span:nth-child(1)": "e((d.tasks[2] || {}).title || '')",
  ":scope > div > main > section:nth-child(4) > div:nth-child(4) > div:nth-child(1) > div:nth-child(2) > span:nth-child(2)": "e((d.tasks[2] || {}).ex || '')",
  ":scope > div > main > section:nth-child(4) > div:nth-child(4) > span:nth-child(2)": "e((d.tasks[2] || {}).done ? t('Đã xong') : t('Mục tiêu nói'))",
