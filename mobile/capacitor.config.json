{
  "appId": "com.lexkite.app",
  "appName": "Lexkite",
  "webDir": "www",
  "backgroundColor": "#f6f7fb",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#0F3D3E",
      "showSpinner": false
    },
    "LocalNotifications": {
      "iconColor": "#E5502F"
    }
  }
}