<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Từ mỗi giờ" (2×2 → 4×2): từ, phiên âm, nghĩa, câu ví dụ (ẩn khi hẹp). Dữ liệu: WordWidget.kt. Cũng là ảnh xem trước trong danh sách widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/word_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lex_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/lex_widget_kite" />
        <TextView
            android:id="@+id/word_title"
            android:text="@string/word_widget_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/lex_widget_sub"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:layoutDirection="ltr"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/word_word"
            android:text="meticulous"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/lex_widget_ink"
            android:textDirection="ltr"
            android:textSize="26sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/word_ipa"
            android:text="/məˈtɪkjələs/"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/lex_widget_sub"
            android:textDirection="ltr"
            android:textSize="13sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/word_mean"
        android:text="very careful about every detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:textColor="@color/lex_widget_ink"
        android:textSize="15sp" />
    <TextView
        android:id="@+id/word_ex"
        android:text="“She keeps meticulous notes of every lesson.”"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:textColor="@color/lex_widget_sub"
        android:textDirection="ltr"
        android:textSize="13sp"
        android:textStyle="italic" />
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
