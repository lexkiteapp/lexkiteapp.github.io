<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Từ mỗi giờ" cỡ thấp (2×1 → 4×1): từ + nghĩa 1 dòng. Dữ liệu: WordWidget.kt -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/word_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lex_widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:layoutDirection="ltr"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/word_word"
            android:text="meticulous"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/lex_widget_ink"
            android:textDirection="ltr"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/word_ipa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/lex_widget_sub"
            android:textDirection="ltr"
            android:textSize="12sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/word_mean"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="@color/lex_widget_ink"
        android:textSize="14sp" />
</LinearLayout>
