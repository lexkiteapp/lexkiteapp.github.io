      "ipa",
      "pos",
      "vi",
      "def",
      "ex",
      "col",
      "syn",
      "level",
      "emoji",
      "topic"
    ],
    "activity": "max(srs.last, added, mod) – newer activity wins per card; tie → larger stable JSON (sorted keys) of the FAT card wins",
    "keyRule": "lowercase; ’ ‘ ` → '; collapse whitespace; trim; tl other than en → \"<tl>:\" prefix",
    "keys": [
      {
        "word": "Curriculum",
        "tl": "en",
        "key": "curriculum"
      },
      {
        "word": "  Well   Being ",
        "tl": "en",
        "key": "well being"
