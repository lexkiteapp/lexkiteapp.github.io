    "content": {
      "url": "https://lexkite.com/native/content/{type}.json",
      "types": [
        "today",
        "modules",
        "banner"
      ],
      "source": "native/shared/content/<type>.json",
      "publish": "scripts/native/content-publish.mjs sign (CI, OTA_SIGNING_KEY) → web/native/content/<type>.json (committed, served by Cloudflare Pages)",
      "key": "web/js/ota-key.js LK_OTA_KEY (ECDSA P-256 SPKI base64)",
      "envelope": "see scripts/native/content-schema.mjs + vectors/compat.json",
