    "drive": {
      "space": "appDataFolder",
      "file": "lexkite-sync.v2.json.gz",
      "prefix": "lexkite-sync",
      "schema": 2,
      "backups": 3,
      "envelope": "gzip(JSON {kind: prefix, v: schema, sha: hex(SHA-256(data)), data: JSON string of the Doc})"
    },
    "d1": {
      "endpoint": "POST https://lexkite.com/api/sync (Authorization: Bearer <Firebase ID token>)",
      "docs": "meta + cards_0..cards_{NB-1}",
      "NB": 32,
      "bucketOf": "FNV-1a 32-bit over UTF-16 code units of the key, % NB",
      "bucketVectors": [
        {
          "key": "curriculum",
          "bucket": 26
        },
        {
          "key": "well being",
          "bucket": 22
        },
        {
          "key": "don't",
          "bucket": 13
        },
        {
          "key": "naïve",
          "bucket": 12
        },
        {
          "key": "食べる",
          "bucket": 26
        },
        {
          "key": "niño",
          "bucket": 28
        },
        {
          "key": "constructor",
          "bucket": 15
        },
        {
          "key": "ja:食べる",
          "bucket": 11
        },
        {
          "key": "es:niño",
          "bucket": 0
        }
      ],
      "hash": "h = (h*31 + charCode) | 0 over UTF-16 code units; \"<h>:<length>\"",
      "hashVectors": [
        {
          "in": "",
          "out": "0:0"
        },
        {
          "in": "{}",
          "out": "3938:2"
        },
        {
