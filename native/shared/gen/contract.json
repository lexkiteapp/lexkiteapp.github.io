{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lexkite.com/schemas/sync-doc.v2.json",
  "title": "Lexkite sync document v2 (web, add-on, iOS, Android – one account, one schema)",
  "description": "GENERATED by scripts/native/gen.mjs from web/js/core.js (Cards.make, SRS), web/js/sync.js (slim/fat, snapLocal, mergeIn) and web/js/sync-drive.js. Drive appDataFolder holds one Doc; D1 /api/sync holds meta + cards_0..31. Merge rules: vectors/sync.json.",
  "type": "object",
  "required": [
    "v",
    "cards",
    "deleted",
    "stats",
    "settings",
    "settingsAt"
  ],
  "properties": {
    "v": {
      "const": 2
    },
    "at": {
      "type": "integer",
      "description": "ms epoch of the snapshot (Drive only)"
    },
    "cards": {
      "type": "object",
      "description": "key → slim card; key = Core.tlKey(word, tl)",
      "additionalProperties": {
        "$ref": "#/$defs/card"
      }
    },
    "deleted": {
      "$ref": "#/$defs/deleted"
    },
    "stats": {
      "$ref": "#/$defs/stats"
    },
    "game": {
      "anyOf": [
        {
          "$ref": "#/$defs/game"
        },
        {
          "type": "null"
        }
      ]
    },
    "settings": {
      "type": "object",
      "description": "user settings (DEFAULT_SETTINGS keys + more); whole object wins by settingsAt"
    },
    "settingsAt": {
      "type": "integer"
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "properties": {
        "L": {
          "type": "integer"
        },
        "added": {
          "type": "integer"
        },
        "audio": {
          "type": "string"
        },
        "col": {
          "type": "array"
        },
        "contexts": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "integer"
              },
              "source": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "at",
              "source",
              "text",
              "title"
            ]
          }
        },
        "ctx": {
          "type": "string"
        },
        "def": {
          "type": "string"
        },
        "emoji": {
          "type": "string"
        },
        "ex": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "imageCredit": {
          "type": [
            "null",
            "object"
          ]
        },
        "ipa": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "mod": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        },
        "pos": {
          "type": "string"
        },
        "src": {
          "type": "string"
        },
        "srs": {
          "type": "object",
          "properties": {
            "D": {
              "type": "number"
            },
            "S": {
              "type": "number"
            },
            "due": {
              "type": "integer"
            },
            "ef": {
              "type": "number"
            },
            "interval": {
              "type": "integer"
            },
            "lapses": {
              "type": "integer"
            },
            "last": {
              "type": [
                "integer",
                "null"
              ]
            },
            "reps": {
              "type": "integer"
            },
            "step": {
              "type": "integer"
            }
          },
          "required": [
            "due",
            "ef",
            "interval",
            "lapses",
            "last",
            "reps",
            "step"
          ]
        },
        "syn": {
          "type": "array"
        },
        "tl": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "vi": {
          "type": "string"
        },
        "word": {
          "type": "string"
        }
      },
      "required": [
        "added",
        "imageCredit",
        "srs",
        "word"
      ],
      "description": "slim() card: sentences/ipaUS dropped; empty contexts/note/image/audio dropped; library cards (L:1) drop fields equal to the library entry (fat() restores them from the lexicon). Unknown fields must be preserved; readers must tolerate missing optional fields (fat() fills them from cardDefaults).",
      "additionalProperties": true
    },
    "deleted": {
      "type": "object",
      "description": "tombstones key → ms; merged by max; pruned when older than 90 days",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "stats": {
      "type": "object",
      "properties": {
        "days": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "newToday": {
          "type": "object",
          "properties": {
            "day": {
              "type": "string"
            },
            "n": {
              "type": "integer"
            }
          }
        },
        "hours": {
          "type": "array",
          "minItems": 24,
          "maxItems": 24,
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "days"
      ]
    },
    "game": {
      "type": "object",
      "description": "Game.get() shape (EMPTY() + stored); merged by mergeGame0 (xp/days/total max, badges union, best.match min, unitDone max, freezes from higher-xp side, ret by mergeRet). questsDone is sent empty.",
      "properties": {
        "xp": {
          "type": "integer"
        },
        "days": {
          "type": "object"
        },
        "total": {
          "type": "object"
        },
        "best": {
          "type": "object"
        },
        "badges": {
          "type": "object"
        },
        "questsDone": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "d1Meta": {
      "type": "object",
      "description": "D1 doc \"meta\" body after gunzip: { stats, game (questsDone {}), settings, settingsAt, deleted }",
      "properties": {
        "stats": {
          "$ref": "#/$defs/stats"
        },
        "game": {
          "$ref": "#/$defs/game"
        },
        "settings": {
          "type": "object"
        },
        "settingsAt": {
          "type": "integer"
        },
        "deleted": {
          "$ref": "#/$defs/deleted"
        }
      }
    }
  },
  "x-lexkite": {
    "cardDefaults": {
      "word": "x",
      "ipa": "",
      "ipaUS": "",
      "pos": "",
      "vi": "",
      "def": "",
      "ex": "",
      "col": [],
      "syn": [],
      "level": "",
      "topic": "mine",
      "emoji": "📘",
      "image": "",
      "imageCredit": null,
      "audio": "",
      "sentences": [],
