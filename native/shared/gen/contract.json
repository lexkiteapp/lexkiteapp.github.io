          "out": "-1442153986:7"
        },
        {
          "in": "naïve ☕ 食べる",
          "out": "137297073:11"
        },
        {
          "in": "{\"word\":\"kerfuffle\",\"ipa\":\"\",\"pos\":\"\",\"vi\":\"nghĩa của kerfuffle\",\"def\":\"\",\"ex\":\"\",\"col\":[],\"syn\":[],\"level\":\"\",\"topic\":\"mine\",\"emoji\":\"📘\",\"imageCredit\":null,\"contexts\":[{\"text\":\"k sentence 2 from a news article.\",\"source\":\"https://news.example.org/k/2\",\"title\":\"k 2\",\"at\":1770724860000},{\"text\":\"k sentence 1 from a news article.\",\"source\":\"https://news.example.org/k/1\",\"title\":\"k 1\",\"at\":1770724800000}],\"added\":1770724800000,\"srs\":{\"ef\":2.5,\"interval\":11,\"reps\":2,\"lapses\":0,\"due\":1772251200000,\"last\":1771329600000,\"step\":0,\"S\":11.14,\"D\":6.682},\"mod\":1771329600000}",
          "out": "1019085652:570"
        }
      ],
      "body": "{ json } or { z: base64(gzip(json)) } when smaller"
    },
    "store": {
      "indexedDB": "lexkite",
      "objectStore": "kv",
      "prefix": "ielts.",
      "legacyDb": "vocaband",
      "bigKeys": [
        "cards",
        "dcIndex",
        "sentences"
      ]
    },
