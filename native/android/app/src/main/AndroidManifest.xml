<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- P03 say exercise: asked only when the learner taps the microphone -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>
    <application
        android:name=".LexkiteApp"
        android:label="Lexkite"
        android:supportsRtl="true"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Crashlytics only in release (placeholder per build type); no personal data, only a hashed uid -->
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="${crashlytics}" />
        <activity android:name=".MainActivity" android:exported="true" android:theme="@style/Theme.Lexkite.Starting" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- C08: same deep-link scheme as the live app (lexkite://review, lexkite://word/<w>) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lexkite" />
            </intent-filter>
            <!-- C08: verified app links https://lexkite.com/app/#/… (needs the native signing SHA-256 in lexkite.com/.well-known/assetlinks.json) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="lexkite.com" />
                <data android:host="www.lexkite.com" />
                <data android:pathPrefix="/app" />
            </intent-filter>
        </activity>
    </application>
</manifest>
