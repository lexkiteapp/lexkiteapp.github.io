  { "id": "m_q", "text": "Quiz! Which one is right, A or B?", "key": { "yellow": [0] }, "gap": 0.3 },
  { "id": "_count", "beat": "count", "dur": 3.0 },
  { "id": "m_a", "text": "B! I agree with you.", "key": { "green": [0, 2] } },
