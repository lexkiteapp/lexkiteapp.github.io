      "title": "Favourite Places",
      "sentences": [
        {
          "who": "A",
          "text": "Carlos, do you like our city?"
        },
        {
          "who": "B",
          "text": "Yes, I do. It is big and busy."
        },
        {
          "who": "A",
          "text": "Where do you go on Sunday?"
        },
        {
          "who": "B",
          "text": "I go to the park. It is very green."
        },
        {
          "who": "A",
          "text": "I like the park too. I sit under a tree."
        },
        {
          "who": "B",
          "text": "Is there a shop near the park?"
        },
        {
          "who": "A",
          "text": "Yes, there is a small shop."
        },
        {
          "who": "B",
          "text": "Can we buy ice cream there?"
        },
        {
          "who": "A",
          "text": "Yes, we can. It is cheap and good."
        },
        {
          "who": "B",
          "text": "Let us go together this Sunday."
        },
        {
          "who": "A",
          "text": "Great idea! I am free in the afternoon."
        },
        {
          "who": "B",
          "text": "Then it is a plan."
        }
