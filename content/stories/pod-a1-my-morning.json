      "sentences": [
        {
          "who": "A",
          "text": "Hello, Carlos! How are you?"
        },
        {
          "who": "B",
          "text": "I am fine, Ama. I am hungry."
        },
        {
          "who": "A",
          "text": "Do you eat breakfast every day?"
        },
        {
          "who": "B",
          "text": "Yes, I do. I eat bread and eggs."
        },
        {
          "who": "A",
          "text": "I like eggs too. I eat them with tea."
        },
        {
          "who": "B",
          "text": "Do you drink milk?"
        },
        {
          "who": "A",
          "text": "No, I do not. I drink tea."
        },
        {
          "who": "B",
          "text": "What time do you eat?"
        },
        {
          "who": "A",
          "text": "I eat at seven o'clock."
        },
        {
          "who": "B",
          "text": "I eat at eight. I wake up late."
        },
        {
          "who": "A",
          "text": "I get up early. I like the morning."
        },
        {
          "who": "B",
          "text": "You are very busy!"
        }
