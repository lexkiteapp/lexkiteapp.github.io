{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "lexkite/target-deck",
 "title": "Bộ từ ngôn ngữ đích (content/target/<tl>/*.json) – kiểm bởi scripts/target/lib.mjs validate() + scripts/test/target-lang.mjs",
 "type": "object",
 "required": [
  "v",
  "tl",
  "words"
 ],
 "properties": {
  "v": {
   "const": 1
  },
  "tl": {
   "type": "string",
   "pattern": "^[a-z]{2}$"
  },
  "variant": {
   "const": "ja-JP"
  },
  "source": {
   "type": "object"
  },
  "words": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "word",
     "pos",
     "kana",
     "romaji",
     "pitch",
     "jlpt",
     "ipa",
     "gl",
     "ex"
    ],
    "properties": {
     "word": {
      "type": "string",
      "pattern": "^\\p{L}[\\p{L}' -]*$"
     },
     "pos": {
      "enum": [
       "n",
       "v",
       "adj",
       "adv",
       "pron",
       "prep",
       "conj",
       "num",
       "interj",
       "det"
      ]
     },
     "kana": {
      "type": "string",
      "pattern": "^[\\u3041-\\u3096\\u30a1-\\u30f6\\u30fc]+$",
      "description": "cách đọc (hiragana; từ katakana thì katakana) – furigana theo khối kanji (scripts/target/ja-kana.mjs ruby), phải khớp chữ"
     },
     "romaji": {
      "type": "string",
      "description": "romaji kiểu gõ IME, SINH từ kana (ja-kana.mjs romaji) – trợ giúp tắt dần"
     },
     "pitch": {
      "type": "integer",
      "minimum": 0,
      "description": "cao độ Tokyo: vị trí mora hạ giọng kiểu NHK (0 = heiban), ≤ số mora"
     },
     "jlpt": {
      "enum": [
       5,
       4,
       3,
       2,
       1
      ],
      "description": "cấp JLPT N5…N1"
     },
     "vclass": {
      "enum": [
       "ichidan",
       "godan",
       "irregular"
      ],
      "description": "bắt buộc khi pos = v, khớp đuôi kana"
     },
     "aclass": {
      "enum": [
       "i",
       "na"
      ],
      "description": "bắt buộc khi pos = adj (i: kana tận cùng い)"
     },
     "ipa": {
      "type": "string",
      "description": "IPA Tokyo rộng SINH từ kana (ja-kana.mjs ipa), không dấu gạch chéo, không dấu cao độ"
     },
     "emoji": {
      "type": "string"
     },
     "img": {
      "type": "string",
      "pattern": "^[a-z][a-z' -]*#[a-z]+$",
      "description": "khóa tiếng Anh từ#loại có trong content/lexicon/img.json items – CHỈ khi đúng nghĩa"
     },
     "gl": {
      "type": "object",
      "required": [
       "vi",
       "en",
       "es",
       "pt",
       "fr",
       "de",
       "id",
       "th",
       "zh",
       "ja",
       "ko",
       "hi",
       "ar",
       "ru",
       "tr"
      ],
      "additionalProperties": false,
      "properties": {
       "vi": {
        "type": "string",
        "minLength": 1
       },
       "en": {
        "type": "string",
        "minLength": 1
       },
       "es": {
        "type": "string",
        "minLength": 1
       },
       "pt": {
        "type": "string",
        "minLength": 1
       },
       "fr": {
        "type": "string",
        "minLength": 1
       },
       "de": {
        "type": "string",
        "minLength": 1
       },
       "id": {
        "type": "string",
        "minLength": 1
       },
       "th": {
        "type": "string",
        "minLength": 1
       },
       "zh": {
        "type": "string",
        "minLength": 1
       },
       "ja": {
        "type": "string",
        "minLength": 1
       },
       "ko": {
        "type": "string",
        "minLength": 1
       },
       "hi": {
        "type": "string",
        "minLength": 1
       },
       "ar": {
        "type": "string",
        "minLength": 1
       },
       "ru": {
        "type": "string",
        "minLength": 1
       },
       "tr": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "ex": {
      "type": "object",
      "required": [
       "ja",
       "en"
      ],
      "properties": {
       "en": {
        "type": "string"
       },
       "ja": {
        "type": "string",
        "description": "câu tự nhiên thể lịch sự です/ます, chữ Nhật không cách, kết thúc 。/？"
       }
      }
     },
     "exForm": {
      "type": "string",
      "description": "dạng chia của từ xuất hiện trong ex.pt khi khác từ gốc"
     },
     "rank": {
      "type": "integer",
      "description": "thứ hạng tần suất (bộ lõi do scripts/target/gen.mjs sinh)"
     },
     "qa": {
      "type": "object",
      "description": "kết quả cổng: giám khảo + dịch ngược"
     }
    }
   }
  }
 }
}
