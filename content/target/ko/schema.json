{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "lexkite/target-deck",
 "title": "Bộ từ ngôn ngữ đích (content/target/<tl>/*.json) – kiểm bởi scripts/target/lib.mjs validate() + scripts/test/target-lang.mjs",
 "type": "object",
 "required": [
  "v",
  "tl",
  "words"
 ],
 "properties": {
  "v": {
   "const": 1
  },
  "tl": {
   "type": "string",
   "pattern": "^[a-z]{2}$"
  },
  "variant": {
   "const": "ko-KR"
  },
  "source": {
   "type": "object"
  },
  "words": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "word",
     "pos",
     "pron",
     "romaja",
     "topik",
     "ipa",
     "gl",
     "ex"
    ],
    "properties": {
     "word": {
      "type": "string",
      "pattern": "^[\\uac00-\\ud7a3]+$",
      "description": "chữ Hangul trọn âm tiết (NFC); vị từ ở dạng từ điển …다; danh từ không kèm tiểu từ"
     },
     "pos": {
      "enum": [
       "n",
       "v",
       "adj",
       "adv",
       "pron",
       "prep",
       "conj",
       "num",
       "interj",
       "det"
      ]
     },
     "ipa": {
      "type": "string",
      "description": "IPA Tokyo rộng SINH từ kana (ja-kana.mjs ipa), không dấu gạch chéo, không dấu cao độ"
     },
     "emoji": {
      "type": "string"
     },
     "img": {
      "type": "string",
      "pattern": "^[a-z][a-z' -]*#[a-z]+$",
      "description": "khóa tiếng Anh từ#loại có trong content/lexicon/img.json items – CHỈ khi đúng nghĩa"
     },
     "gl": {
      "type": "object",
      "required": [
       "vi",
       "en",
       "es",
       "pt",
       "fr",
       "de",
       "id",
       "th",
       "zh",
       "ja",
       "ko",
       "hi",
       "ar",
       "ru",
       "tr"
      ],
      "additionalProperties": false,
      "properties": {
       "vi": {
        "type": "string",
        "minLength": 1
       },
       "en": {
        "type": "string",
        "minLength": 1
       },
       "es": {
        "type": "string",
        "minLength": 1
       },
       "pt": {
        "type": "string",
        "minLength": 1
       },
       "fr": {
        "type": "string",
        "minLength": 1
       },
       "de": {
        "type": "string",
        "minLength": 1
       },
       "id": {
        "type": "string",
        "minLength": 1
       },
       "th": {
        "type": "string",
        "minLength": 1
       },
       "zh": {
        "type": "string",
        "minLength": 1
       },
       "ja": {
        "type": "string",
        "minLength": 1
       },
       "ko": {
        "type": "string",
        "minLength": 1
       },
       "hi": {
        "type": "string",
        "minLength": 1
       },
       "ar": {
        "type": "string",
        "minLength": 1
       },
       "ru": {
        "type": "string",
        "minLength": 1
       },
       "tr": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "ex": {
      "type": "object",
      "required": [
       "ko",
       "en"
      ],
      "properties": {
       "ko": {
        "type": "string",
        "description": "một câu tự nhiên thể lịch sự 해요체, chữ Hangul (không Hán tự/Latin), kết thúc …요. hoặc …요?; chứa từ (hoặc exForm) ở đầu một 어절"
       },
       "en": {
        "type": "string"
       }
      }
     },
     "exForm": {
      "type": "string",
      "description": "dạng chia của từ xuất hiện trong ex.pt khi khác từ gốc"
     },
     "rank": {
      "type": "integer",
      "description": "thứ hạng tần suất (bộ lõi do scripts/target/gen.mjs sinh)"
     },
     "qa": {
      "type": "object",
      "description": "kết quả cổng: giám khảo + dịch ngược"
     },
     "pron": {
      "type": "string",
      "pattern": "^[\\uac00-\\ud7a3]+$",
      "description": "phát âm chuẩn (표준 발음법) dạng Hangul – SINH từ chữ bằng scripts/target/ko-hangul.mjs pron (ngoại lệ theo từ ở pronX)"
     },
     "romaja": {
      "type": "string",
      "pattern": "^[a-z]+$",
      "description": "Romaja quốc ngữ 2000 (RR) – SINH từ chữ (ko-hangul.mjs romaja): theo phát âm cho đồng hoá phụ âm, không ghi căng hoá, nguyên âm theo chữ"
     },
     "topik": {
      "enum": [
       1,
       2,
       3,
       4,
       5,
       6
      ],
      "description": "cấp TOPIK (I = 1–2, II = 3–6) ~ A1…C2"
     },
     "conj": {
      "enum": [
       "reg",
       "하",
       "ㅂ",
       "ㄷ",
       "ㅅ",
       "ㅎ",
       "르",
       "러",
       "으",
       "ㄹ",
       "우",
       "이"
      ],
      "description": "CHỈ v/adj: lớp chia (quy tắc / bất quy tắc) – phải khớp hình thức gốc (ko-hangul.mjs conjShape)"
     },
     "hanja": {
      "type": "string",
      "pattern": "^\\p{Script=Han}+$",
      "description": "Hán tự gốc của từ Hán-Hàn (tuỳ chọn), đủ số âm tiết"
     },
     "pronX": {
      "type": "object",
      "additionalProperties": false,
      "description": "ngoại lệ phát âm THEO TỪ (không đoán được từ chữ): vị trí âm tiết 0…",
      "properties": {
       "tense": {
        "type": "array",
        "items": {
         "type": "integer",
         "minimum": 0
        },
        "minItems": 1
       },
       "nIns": {
        "type": "array",
        "items": {
         "type": "integer",
         "minimum": 0
        },
        "minItems": 1
       },
       "nn": {
        "type": "array",
        "items": {
         "type": "integer",
         "minimum": 0
        },
        "minItems": 1
       },
       "noLiaison": {
        "type": "array",
        "items": {
         "type": "integer",
         "minimum": 0
        },
        "minItems": 1
       },
       "lbP": {
        "type": "array",
        "items": {
         "type": "integer",
         "minimum": 0
        },
        "minItems": 1
       }
      }
     }
    }
   }
  }
 }
}
