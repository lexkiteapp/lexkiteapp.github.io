    { "id": "account", "match": "web/js/(account|account-delete|sync|sync-drive|native-auth|settings|export|handoff)\\.js|/(Account|Auth|Sync|LegacyMigration)[A-Za-z]*\\.(swift|kt)$|native/[^/]+/.*(LKSync|LKStore|feature-me)", "vi": "Đăng nhập và đồng bộ tiến độ giữa các thiết bị ổn định hơn." },
