    { "id": "widget", "match": "mobile/(ios/App/LexkiteWidget|android/app/src/main/java/.*Widget)|web/js/widget-feed\\.js|Widget", "vi": "Tiện ích màn hình chính giúp bạn ôn từ mỗi ngày dễ hơn." },
    { "id": "languages", "subject": "bản dịch|dịch thật|i18n|ngôn ngữ|translation", "match": "^i18n/ui/|^web/js/i18n/", "vi": "Bản dịch giao diện tự nhiên hơn ở cả 15 ngôn ngữ." }
