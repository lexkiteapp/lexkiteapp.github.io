    { "id": "dict", "match": "web/js/(dictionary|dict-page|lex|lexis|wordcard|vocab-img|phrases|usage[\\w-]*)\\.js|web/js/(vimg|usage)/|web/(data|packs|img)/|/(Dictionary|Word)[A-Za-z]*\\.(swift|kt)$", "vi": "Tra từ nhanh hơn, nghĩa và ví dụ rõ ràng, dễ nhớ hơn." },
    { "id": "speak", "match": "web/js/(speak|pron|call|roleplay)/|web/js/(speaking|pron|say|say-text|roleplay|call|handsfree)\\.js|content/(situations|pron|speak)/|/(Speak|Pron)[A-Za-z]*\\.(swift|kt)$", "vi": "Luyện nói và phát âm tự nhiên hơn, phản hồi dễ hiểu hơn." },
    { "id": "listen", "match": "web/js/listen/|web/js/(listening|audio|audio-offline|watch|watch-topics|lesson-video)\\.js|web/audio/|/(Listen|Audio)[A-Za-z]*\\.(swift|kt)$", "vi": "Nghe rõ hơn với bài nghe và giọng đọc được chăm chút kỹ." },
    { "id": "write", "match": "web/js/write/|web/js/(write|writecheck-rules|task1|paraphrase|fixer)\\.js|/Write[A-Za-z]*\\.(swift|kt)$", "vi": "Luyện viết với gợi ý sửa câu chính xác và dễ hiểu hơn." },
    { "id": "grammar", "match": "web/js/grammar/|web/js/(grammar|structures|verbs|verbs-core|word-arrange|letters)\\.js|content/grammar/|/Grammar[A-Za-z]*\\.(swift|kt)$", "vi": "Ngữ pháp dễ hiểu hơn với ví dụ gần gũi đời thường." },
    { "id": "exams", "match": "web/js/(toeic|toefl|readtest)/|web/js/(toeic|toefl|mock|placement|reading|readings|readings-more|criteria|cbt|target)\\.js|/(Exam|Test)[A-Za-z]*View\\.(swift|kt)$", "vi": "Luyện thi IELTS, TOEIC, TOEFL sát đề thật hơn." },
